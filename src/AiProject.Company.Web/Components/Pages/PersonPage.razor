@page "/people/{Id:guid}"
@rendermode InteractiveServer
@inject PeopleCommands Commands
@inject DirectoryQueries Directory
@inject IAuthorizationGate Gate

<PageTitle>人員卡片</PageTitle>
@if (_person is null)
{
    <p>找不到這個人。</p>
}
else
{
    <div class="page-head">
        <div>
            <h1>@_person.DisplayName</h1>
            <p class="hint lede">@_person.EmploymentKind.Display() · @_person.Status.Display() @(string.IsNullOrEmpty(_vendorName) ? "" : "· " + _vendorName)</p>
        </div>
        <div class="page-actions">
            <a class="btn-sec" href="/people">回名冊</a>
        </div>
    </div>
    <Flash Text="@_message" />
    <div class="tabs" role="tablist" aria-label="人員卡片">
        <button type="button" class="tab @(_tab == "profile" ? "is-on" : "")" @onclick='() => _tab = "profile"'>主檔</button>
        <button type="button" class="tab @(_tab == "work" ? "is-on" : "")" @onclick='() => _tab = "work"'>派工與工時</button>
    </div>
    @if (_tab == "profile")
    {
        <section class="card">
            <div class="form-grid">
                <label>顯示名 <input @bind="_name" /></label>
                <label>Email <input @bind="_email" /></label>
                <label>部門 <input @bind="_department" /></label>
                <label>直屬主管
                    <select @bind="_manager">
                        <option value="">無</option>
                        @foreach (var p in _managers)
                        {
                            <option value="@p.Id">@p.DisplayName</option>
                        }
                    </select>
                </label>
                <label>狀態
                    <select @bind="_status">
                        <option value="@PersonStatus.Active">在職</option>
                        <option value="@PersonStatus.Inactive">停用</option>
                        <option value="@PersonStatus.Blacklisted">黑名單</option>
                    </select>
                </label>
                <label>每週上限 <input type="number" @bind="_cap" /></label>
                <label class="full">技能（逗號） <input @bind="_skills" /></label>
                <label>GitHub <input @bind="_github" /></label>
                <label>不可派起 <input type="date" @bind="_unavailStart" /></label>
                <label>不可派迄 <input type="date" @bind="_unavailEnd" /></label>
                <label>不可派原因 <input @bind="_unavailReason" /></label>
                <label>月薪 <input type="@(_showPay ? "text" : "password")" @bind="_salary" autocomplete="off" /></label>
                <label>對內時計費率 <input type="@(_showPay ? "text" : "password")" @bind="_hourly" autocomplete="off" /></label>
                <label>改費率原因 <input @bind="_reason" /></label>
            </div>
            <p class="hint">GitHub 給控制台上傳對人用，不是後台登入。招募邀請也會自動綁。</p>
            <label class="check"><input type="checkbox" @bind="_exempt" /> 不參與專案分攤</label>
            <div class="toolbar">
                <button class="btn-primary" @onclick="Save">儲存</button>
                <button class="btn-sec" @onclick="Bind">綁定 GitHub</button>
                <button type="button" class="btn-sec" @onclick="Reveal">@(_showPay ? "遮罩薪資" : "顯示薪資")</button>
                <button class="btn-danger" @onclick="Deactivate">停用</button>
            </div>
        </section>
    }
    else
    {
        <div class="workbench is-rail-first">
            <aside class="rail card">
                <h2>目前派工</h2>
                @if (_assignments.Count == 0)
                {
                    <p class="empty">目前沒有進行中的派工。</p>
                }
                else
                {
                    <ul class="stack">
                        @foreach (var a in _assignments)
                        {
                            <li>
                                <strong>@ProjectName(a.ProjectId)</strong>
                                <span class="hint">@a.Role.Display() · @a.Start.ToString("yyyy-MM-dd")–@a.End.ToString("yyyy-MM-dd") · @a.PlannedHoursPerWeek.ToString("0.##") 時/週</span>
                            </li>
                        }
                    </ul>
                }
            </aside>
            <section class="card">
                <h2>近期工時</h2>
                @if (_hours.Count == 0)
                {
                    <p class="empty">還沒有上傳工時。</p>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="grid">
                            <thead>
                                <tr>
                                    <th class="date">日期</th>
                                    <th>專案</th>
                                    <th class="num">小時</th>
                                    <th>狀態</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var h in _hours)
                            {
                                <tr>
                                    <td class="date">@h.WorkDate.ToString("yyyy-MM-dd")</td>
                                    <td>@ProjectName(h.ProjectId)</td>
                                    <td class="num @HourTone(h.Hours)">@h.Hours.ToString("0.##")</td>
                                    <td><span class="@StatusPill(h.Status)">@h.Status.Display()</span></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </div>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery] public string? Tab { get; set; }
    Person? _person;
    string _name = "";
    string _email = "";
    string _department = "";
    string _manager = "";
    string _status = nameof(PersonStatus.Active);
    decimal _cap = 40;
    string _skills = "";
    string _github = "";
    DateOnly _unavailStart = DateOnly.FromDateTime(DateTime.Today);
    DateOnly _unavailEnd = DateOnly.FromDateTime(DateTime.Today);
    string _unavailReason = "";
    bool _exempt;
    string _salary = "";
    string _hourly = "";
    string _reason = "";
    string _message = "";
    string _tab = "profile";
    string _vendorName = "";
    bool _showPay;
    IReadOnlyList<Person> _managers = [];
    IReadOnlyList<Assignment> _assignments = [];
    IReadOnlyList<Timesheet> _hours = [];
    Dictionary<Guid, string> _projectNames = [];

    protected override async Task OnInitializedAsync()
    {
        if (Tab == "work")
            _tab = "work";
        await ReloadAsync();
    }

    async Task ReloadAsync()
    {
        _person = await Directory.PersonAsync(Id);
        if (_person is null)
            return;
        _name = _person.DisplayName;
        _email = _person.Email ?? "";
        _department = _person.Department ?? "";
        _manager = _person.ManagerPersonId?.ToString() ?? "";
        _status = _person.Status.ToString();
        _cap = _person.WeeklyHourCap;
        _skills = string.Join(",", _person.Skills);
        _github = _person.GitHubLogin ?? "";
        _exempt = _person.CostAllocationExempt;
        var people = await Directory.PeopleAsync();
        _managers = people.Where(p => p.Id != Id && p.Status == PersonStatus.Active).ToList();
        if (_person.VendorId is Guid vid)
        {
            var vendors = await Directory.VendorsAsync();
            _vendorName = vendors.FirstOrDefault(v => v.Id == vid)?.Name ?? "";
        }
        var projects = (await Directory.ProjectsAsync()).ToDictionary(p => p.Id, p => p.Name);
        _projectNames = projects;
        var today = Directory.Today();
        _assignments = (await Directory.AssignmentsAsync())
            .Where(a => a.PersonId == Id && a.Status != AssignmentStatus.Cancelled && a.End >= today)
            .OrderBy(a => a.Start)
            .ToList();
        _hours = (await Directory.TimesheetsAsync())
            .Where(t => t.PersonId == Id)
            .OrderByDescending(t => t.WorkDate)
            .Take(20)
            .ToList();
    }

    string ProjectName(Guid id) => _projectNames.TryGetValue(id, out var n) ? n : id.ToString()[..8];

    static string HourTone(decimal hours) => hours >= 10 ? "is-overload" : hours >= 8 ? "is-follow-yellow" : "";

    static string StatusPill(TimesheetStatus status) => status switch
    {
        TimesheetStatus.Approved => "pill pill-ok",
        TimesheetStatus.PendingPm => "pill pill-wait",
        _ => "pill pill-danger",
    };

    void Reveal()
    {
        if (!Gate.Can(PlatformCapability.ViewSalary, personId: Id))
        {
            _message = Messages.RateHidden;
            return;
        }
        _showPay = !_showPay;
    }

    async Task Save()
    {
        decimal? salary = decimal.TryParse(_salary, out var s) ? s : null;
        decimal? hourly = decimal.TryParse(_hourly, out var h) ? h : null;
        var ranges = string.IsNullOrWhiteSpace(_unavailReason)
            ? _person!.Unavailable
            : _person!.Unavailable.Append(new UnavailableRange(_unavailStart, _unavailEnd, _unavailReason)).ToList();
        var managerId = Guid.TryParse(_manager, out var mid) ? mid : (Guid?)null;
        var status = Enum.TryParse<PersonStatus>(_status, out var st) ? st : _person.Status;
        var result = await Commands.UpdatePersonAsync(Id, _name, _email, _department, managerId, _cap, _skills.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries), status, _exempt, ranges, salary, hourly, _reason);
        _message = result.Ok ? "已儲存" : result.Message;
        if (result.Ok)
            await ReloadAsync();
    }

    async Task Bind()
    {
        var result = await Commands.BindGitHubAsync(Id, _github);
        _message = result.Ok ? "已綁定" : result.Message;
        if (result.Ok)
            await ReloadAsync();
    }

    async Task Deactivate()
    {
        var result = await Commands.DeactivateAsync(Id);
        _message = result.Ok ? "已停用，不能新派工；歷史工時仍可查。" : result.Message;
        if (result.Ok)
            await ReloadAsync();
    }
}
