@page "/clients"
@rendermode InteractiveServer
@inject ProjectCommands Commands
@inject DirectoryQueries Directory
@inject IAuthorizationGate Gate

<PageTitle>客戶</PageTitle>
<div class="page-head">
    <div>
        <h1>客戶</h1>
        <p class="hint lede">同一份主檔，用生命週期篩選。成交後才成立合約與專案。</p>
    </div>
    <div class="page-actions">
        @if (Gate.Can(PlatformCapability.ManageClients))
        {
            <button type="button" class="btn-primary" @onclick="() => _createOpen = true">建立客戶</button>
        }
    </div>
</div>
<Flash Text="@_message" />
<div class="tabs" role="tablist">
    <button type="button" class="tab @(_filter is null ? "is-on" : "")" @onclick="ShowAll">全部</button>
    <button type="button" class="tab @(TabOn("lead"))" @onclick="@(() => SetFilter("lead"))">潛在</button>
    <button type="button" class="tab @(TabOn("talk"))" @onclick="@(() => SetFilter("talk"))">議約</button>
    <button type="button" class="tab @(TabOn("live"))" @onclick="@(() => SetFilter("live"))">合約</button>
    <button type="button" class="tab @(TabOn("idle"))" @onclick="@(() => SetFilter("idle"))">休眠</button>
</div>
<div class="cards">
    @foreach (var client in Visible)
    {
        var tone = client.FollowUpTone(_today);
        <a class="proj-card tone-@tone.ToString().ToLowerInvariant()" href="/clients/@client.Id">
            <strong>@client.Name</strong>
            <p>@client.Lifecycle.Display() · @client.Kind · @client.Source.Display()</p>
            <p>窗口 @(client.Contact ?? "未填")</p>
            @if (client.NextFollowUp is DateOnly due)
            {
                <p class="@(tone == HealthTone.Red ? "is-overdue" : tone == HealthTone.Yellow ? "is-follow-yellow" : "")">下次跟進 @due @(tone == HealthTone.Red ? "已逾期" : tone == HealthTone.Yellow ? "逾期" : "")</p>
            }
        </a>
    }
</div>
@if (_clients.Count == 0)
{
    <p class="empty">建立第一個客戶與專案後，戰情室才有真實例外。</p>
}
else if (!Visible.Any())
{
    <p class="empty">這個分頁沒有客戶。</p>
}
<UiDialog Open="_createOpen" Title="建立客戶" OnClose="() => _createOpen = false">
    <div class="stack">
        <label>客戶名稱 <input @bind="_name" /></label>
        <label>種類
            <select @bind="_kind">
                <option value="@ClientKind.External">外部</option>
                <option value="@ClientKind.Internal">內部</option>
            </select>
        </label>
        <label>生命週期
            <select @bind="_lifecycle">
                <option value="@ClientLifecycle.Lead">潛在</option>
                <option value="@ClientLifecycle.Discovery">需求訪談</option>
                <option value="@ClientLifecycle.Proposal">提案議約</option>
                <option value="@ClientLifecycle.Active">合約客戶</option>
            </select>
        </label>
        <label>窗口 <input @bind="_contact" /></label>
        <label>下次跟進 <input type="date" @bind="_follow" /></label>
    </div>
    <div class="dialog-actions">
        <button type="button" class="btn-sec" @onclick="() => _createOpen = false">取消</button>
        <button type="button" class="btn-primary" @onclick="Create">建立客戶</button>
    </div>
</UiDialog>

@code {
    string _name = "";
    string _contact = "";
    ClientKind _kind = ClientKind.External;
    ClientLifecycle _lifecycle = ClientLifecycle.Lead;
    DateOnly? _follow;
    string _message = "";
    bool _createOpen;
    string? _filter;
    DateOnly _today;
    IReadOnlyList<Client> _clients = [];

    IEnumerable<Client> Visible => _clients
        .Where(c => _filter switch
        {
            "lead" => c.Lifecycle == ClientLifecycle.Lead,
            "talk" => c.Lifecycle is ClientLifecycle.Discovery or ClientLifecycle.Proposal,
            "live" => c.Lifecycle == ClientLifecycle.Active,
            "idle" => c.Lifecycle == ClientLifecycle.Dormant,
            _ => true,
        })
        .OrderBy(c => c.NextFollowUp ?? DateOnly.MaxValue)
        .ThenBy(c => c.Name, StringComparer.OrdinalIgnoreCase);

    string TabOn(string key) => _filter == key ? "is-on" : "";
    void ShowAll() => _filter = null;
    void SetFilter(string key) => _filter = key;

    protected override async Task OnInitializedAsync()
    {
        _today = Directory.Today();
        _follow = _today.AddDays(7);
        _clients = await Directory.ClientsAsync();
    }

    async Task Create()
    {
        var result = await Commands.CreateClientAsync(_name, _kind, _contact, _lifecycle, ClientSource.SelfDeveloped, null, null, _follow, null);
        _message = result.Ok ? "已建立" : result.Message;
        if (result.Ok)
        {
            _name = "";
            _contact = "";
            _createOpen = false;
            _clients = await Directory.ClientsAsync();
        }
    }
}
