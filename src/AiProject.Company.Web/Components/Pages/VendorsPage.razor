@page "/vendors"
@rendermode InteractiveServer
@inject PeopleCommands Commands
@inject DirectoryQueries Directory

<PageTitle>外包商</PageTitle>
<div class="page-head">
    <div>
        <h1>外包商</h1>
        <p class="hint lede">卡片只顯示摘要。改費率、有效期進編輯對話框，原因仍要填。</p>
    </div>
    <div class="page-actions">
        <button type="button" class="btn-primary" @onclick="() => _createOpen = true">建立外包商</button>
    </div>
</div>
<Flash Text="@_message" />
<div class="cards">
    @foreach (var card in _cards)
    {
        var vendor = card.Vendor;
        <article class="proj-card">
            <strong>@vendor.Name</strong>
            <p class="meta-line">
                <span>統編 @(string.IsNullOrEmpty(vendor.TaxId) ? "—" : vendor.TaxId)</span>
                <span>有效 @vendor.ValidFrom – @(vendor.ValidTo?.ToString() ?? "—")</span>
            </p>
            <p>本月對帳 @card.MonthHours.ToString("0.##") 時 · 授權專案 @card.ProjectCount · 派駐 @card.Staff.Count 人</p>
            @if (card.Staff.Count == 0)
            {
                <p class="empty">尚無派駐人員。</p>
            }
            else
            {
                <p class="hint">@string.Join("、", card.Staff.Take(4).Select(p => p.DisplayName))@(card.Staff.Count > 4 ? "…" : "")</p>
            }
            <div class="page-actions">
                <button type="button" class="btn-sec" @onclick="() => OpenEdit(card)">編輯</button>
            </div>
        </article>
    }
</div>
@if (_cards.Count == 0)
{
    <p class="empty">還沒有外包商。先建立一筆，人員名冊才能掛承攬派駐。</p>
}
<UiDialog Open="_createOpen" Title="建立外包商" OnClose="() => _createOpen = false">
    <div class="stack">
        <label>公司名 <input @bind="_name" /></label>
        <label>統編 <input @bind="_tax" /></label>
    </div>
    <div class="dialog-actions">
        <button type="button" class="btn-sec" @onclick="() => _createOpen = false">取消</button>
        <button type="button" class="btn-primary" @onclick="Create">建立</button>
    </div>
</UiDialog>
<UiDialog Open="@(_edit is not null)" Title="@("編輯 " + (_edit?.Name ?? ""))" OnClose="() => _edit = null">
    @if (_edit is not null)
    {
        <div class="stack">
            <label>名稱 <input @bind="_edit.Name" /></label>
            <label>統編 <input @bind="_edit.TaxId" /></label>
            <label>有效起 <input type="date" @bind="_edit.From" /></label>
            <label>有效迄 <input type="date" @bind="_edit.To" /></label>
            <label>預設費率 <input type="number" @bind="_edit.DefaultRate" /></label>
            <label>改費率原因 <input @bind="_edit.RateReason" /></label>
        </div>
        <h3>派駐名單</h3>
        @if (_edit.Staff.Count == 0)
        {
            <p class="empty">尚無派駐人員。</p>
        }
        else
        {
            <ul>
                @foreach (var p in _edit.Staff)
                {
                    <li><a href="/people/@p.Id">@p.DisplayName</a> · @p.Status.Display()</li>
                }
            </ul>
        }
        <div class="dialog-actions">
            <button type="button" class="btn-sec" @onclick="() => _edit = null">取消</button>
            <button type="button" class="btn-primary" @onclick="() => Save(_edit)">儲存</button>
        </div>
    }
</UiDialog>

@code {
    string _name = "";
    string _tax = "";
    string _message = "";
    bool _createOpen;
    VendorCard? _edit;
    List<VendorCard> _cards = [];

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    void OpenEdit(VendorCard card) => _edit = card;

    async Task ReloadAsync()
    {
        var vendors = await Directory.VendorsAsync();
        var people = await Directory.PeopleAsync();
        var contracts = await Directory.ContractsAsync();
        var sheets = await Directory.TimesheetsAsync();
        var today = Directory.Today();
        var monthStart = new DateOnly(today.Year, today.Month, 1);
        var monthEnd = monthStart.AddMonths(1).AddDays(-1);
        _cards = vendors.Select(v =>
        {
            var staff = people.Where(p => p.VendorId == v.Id).ToList();
            var staffIds = staff.Select(p => p.Id).ToHashSet();
            var hours = sheets
                .Where(t => staffIds.Contains(t.PersonId) && t.Status != TimesheetStatus.Returned && t.WorkDate >= monthStart && t.WorkDate <= monthEnd)
                .Sum(t => t.Hours);
            var projectCount = contracts.Count(c => c.AuthorizedVendorIds.Contains(v.Id));
            return new VendorCard
            {
                Vendor = v,
                Name = v.Name,
                TaxId = v.TaxId ?? "",
                From = v.ValidFrom,
                To = v.ValidTo ?? today.AddYears(1),
                Staff = staff,
                MonthHours = hours,
                ProjectCount = projectCount,
            };
        }).ToList();
    }

    async Task Create()
    {
        var today = Directory.Today();
        var result = await Commands.CreateVendorAsync(_name, _tax, today, today.AddYears(1));
        _message = result.Ok ? "已建立" : result.Message;
        if (result.Ok)
        {
            _name = "";
            _tax = "";
            _createOpen = false;
            await ReloadAsync();
        }
    }

    async Task Save(VendorCard card)
    {
        decimal? rate = card.DefaultRate > 0 ? card.DefaultRate : null;
        var result = await Commands.UpdateVendorAsync(card.Vendor.Id, card.Name, card.TaxId, card.Vendor.WindowPersonId, card.From, card.To, rate, card.RateReason);
        _message = result.Ok ? $"已更新 {card.Name}" : result.Message;
        if (result.Ok)
        {
            _edit = null;
            await ReloadAsync();
        }
    }

    sealed class VendorCard
    {
        public required Vendor Vendor { get; init; }
        public string Name { get; set; } = "";
        public string TaxId { get; set; } = "";
        public DateOnly From { get; set; }
        public DateOnly To { get; set; }
        public decimal DefaultRate { get; set; }
        public string RateReason { get; set; } = "";
        public IReadOnlyList<Person> Staff { get; init; } = [];
        public decimal MonthHours { get; init; }
        public int ProjectCount { get; init; }
    }
}
