@if (Open)
{
    <div class="scrim" @onclick="Close">
        <div class="dialog @(Wide ? "dialog-lg" : null)" role="dialog" aria-modal="true" aria-labelledby="@_titleId" tabindex="-1" @onclick:stopPropagation="true" @onkeydown="OnKey">
            <div class="dialog-head">
                <h2 id="@_titleId">@Title</h2>
                <button type="button" class="btn-link" @onclick="Close">關閉</button>
            </div>
            @ChildContent
        </div>
    </div>
}

@code {
    readonly string _titleId = "dlg-" + Guid.NewGuid().ToString("N")[..8];

    [Parameter] public bool Open { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public bool Wide { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    async Task Close() => await OnClose.InvokeAsync();

    async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            await Close();
    }
}
