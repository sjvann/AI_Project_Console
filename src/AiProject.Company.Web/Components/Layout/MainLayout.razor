@inherits LayoutComponentBase
@inject ICurrentUser User
@inject IHomeRouteResolver Home
@inject NavigationManager Nav
@inject ReportingQueries Reporting

<div class="shell">
    <ThemeApplier />
    <header class="top">
        <a class="brand" href="@Home.PathFor(User.Role)">AI_Project 公司平台</a>
        <nav class="nav" aria-label="主要">
            @if (User.IsAuthenticated && User.PersonId is not null)
            {
                @if (Can(PlatformCapability.ViewWarRoom))
                {
                    <NavLink href="/war-room">戰情室</NavLink>
                }
                @if (User.Role is PlatformRole.Pm or PlatformRole.Lead or PlatformRole.Delivery or PlatformRole.Owner or PlatformRole.Finance)
                {
                    <NavLink href="/projects">專案</NavLink>
                    <NavLink href="/clients">客戶</NavLink>
                }
                @if (Can(PlatformCapability.Dispatch))
                {
                    <NavLink href="/dispatch">派工</NavLink>
                }
                @if (Can(PlatformCapability.ManagePeople) || User.Role == PlatformRole.Hr)
                {
                    <NavLink href="/people">人員</NavLink>
                    <NavLink href="/vendors">外包商</NavLink>
                }
                @if (Can(PlatformCapability.ManageBudget))
                {
                    <NavLink href="/budget">預算</NavLink>
                }
                @if (Reporting.CanViewInbox)
                {
                    <NavLink href="/reporting">公開回報
                        @if (_badge.Total > 0)
                        {
                            <span class="nav-badge" title="待確認 @_badge.Pending，待歸戶 @_badge.Unmatched">@_badge.Total</span>
                        }
                    </NavLink>
                }
                @if (Can(PlatformCapability.LockPayroll) || Can(PlatformCapability.ConfirmTimesheet))
                {
                    <NavLink href="/payroll">@(Can(PlatformCapability.LockPayroll) ? "薪資" : "工時確認")</NavLink>
                }
                @if (User.Role.LandsOnMyHours() || User.Role == PlatformRole.Engineer)
                {
                    <NavLink href="/me">我的工時</NavLink>
                }
                @if (Can(PlatformCapability.ManageSettings) || Can(PlatformCapability.InviteUser))
                {
                    <NavLink href="/accounts">帳戶</NavLink>
                }
                @if (Can(PlatformCapability.ManageSettings))
                {
                    <NavLink href="/settings">設定</NavLink>
                }
            }
        </nav>
        <div class="who">
            @if (User.IsAuthenticated)
            {
                <span>@User.DisplayName · @User.Role.Display()</span>
                <form method="post" action="/logout">
                    <AntiforgeryToken />
                    <button type="submit" class="btn-sec">登出</button>
                </form>
            }
            else
            {
                <a class="btn-primary" href="/login">登入</a>
            }
        </div>
    </header>
    <main class="main">
        @Body
    </main>
</div>

@code {
    [Inject] IAuthorizationGate Gate { get; set; } = default!;
    ReportingBadge _badge = ReportingBadge.Empty;

    bool Can(PlatformCapability capability) => Gate.Can(capability);

    protected override async Task OnParametersSetAsync()
    {
        if (User.IsAuthenticated && User.PersonId is not null && Reporting.CanViewInbox)
            _badge = await Reporting.BadgeAsync();
        else
            _badge = ReportingBadge.Empty;
    }
}
