<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AiProject.Console.Core</RootNamespace>
    <Description>控制台核心：掃描、編譯、服務編排</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Actions\actions.json" />
    <EmbeddedResource Include="Stack\mcp-icon.png" />
    <EmbeddedResource Include="..\..\assets\brand\logo.svg" LogicalName="AiProject.Console.Core.Brand.logo.svg" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AiProject.Shared.Update\AiProject.Shared.Update.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AiProject.Console.Core.Tests" />
  </ItemGroup>

</Project>
