{
  "consoleVersion": "0.3",
  "description": "AI_Project Console 動作目錄（建置／GitHub／部署）。",
  "actions": [
    {
      "id": "build_stale",
      "label": "編譯過期項目",
      "group": "build",
      "kind": "internal",
      "handler": "build_stale"
    },
    {
      "id": "build_services",
      "label": "全部服務",
      "group": "build",
      "kind": "internal",
      "handler": "build_services"
    },
    {
      "id": "build_projects",
      "label": "全部專案",
      "group": "build",
      "kind": "internal",
      "handler": "build_projects",
      "confirm": "將編譯專案目錄內全部 csproj（含測試），可能需要數分鐘，確定執行？"
    },
    {
      "id": "github_clone",
      "label": "從遠端開啟…",
      "group": "github",
      "kind": "internal",
      "handler": "github_clone"
    },
    {
      "id": "github_settings",
      "label": "GitHub 設定…",
      "group": "github",
      "kind": "internal",
      "handler": "github_settings"
    },
    {
      "id": "github_status",
      "label": "狀態",
      "group": "github",
      "kind": "internal",
      "handler": "github_status"
    },
    {
      "id": "github_sync",
      "label": "同步（pull）",
      "group": "github",
      "kind": "internal",
      "handler": "github_sync",
      "requiresGithub": true,
      "confirm": "將自 remote fetch 並 pull --rebase 目前分支。確定？"
    },
    {
      "id": "github_publish",
      "label": "發布（push）",
      "group": "github",
      "kind": "internal",
      "handler": "github_publish",
      "requiresGithub": true,
      "confirm": "將 push 目前分支到 remote。確定？"
    },
    {
      "id": "github_open",
      "label": "開啟倉庫",
      "group": "github",
      "kind": "internal",
      "handler": "github_open",
      "requiresGithub": true
    },
    {
      "id": "github_pr",
      "label": "建立／開啟 PR",
      "group": "github",
      "kind": "internal",
      "handler": "github_pr",
      "requiresGithub": true
    },
    {
      "id": "github_actions",
      "label": "Actions 最近執行",
      "group": "github",
      "kind": "internal",
      "handler": "github_actions",
      "requiresGithub": true
    },
    {
      "id": "deploy_settings",
      "label": "部署設定…",
      "group": "deploy",
      "kind": "internal",
      "handler": "deploy_settings"
    },
    {
      "id": "deploy_status",
      "label": "部署狀態",
      "group": "deploy",
      "kind": "internal",
      "handler": "deploy_status",
      "requiresDeploy": true
    },
    {
      "id": "deploy_open",
      "label": "開啟線上",
      "group": "deploy",
      "kind": "internal",
      "handler": "deploy_open",
      "requiresDeploy": true
    },
    {
      "id": "deploy_ci_hint",
      "label": "部署說明",
      "group": "deploy",
      "kind": "internal",
      "handler": "deploy_ci_hint",
      "requiresDeploy": true
    }
  ]
}
