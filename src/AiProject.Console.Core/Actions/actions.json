{
  "consoleVersion": "0.3",
  "description": "AI_Project Console 動作目錄（建置／GitHub／部署）。",
  "actions": [
    {
      "id": "build_stale",
      "label": "編譯過期項目",
      "group": "build",
      "kind": "internal",
      "handler": "build_stale"
    },
    {
      "id": "build_services",
      "label": "全部服務",
      "group": "build",
      "kind": "internal",
      "handler": "build_services"
    },
    {
      "id": "build_projects",
      "label": "全部專案",
      "group": "build",
      "kind": "internal",
      "handler": "build_projects",
      "confirm": "將編譯專案目錄內全部偵測到的專案（含測試），可能需要數分鐘，確定執行？"
    },
    {
      "id": "build_test",
      "label": "跑測試",
      "group": "build",
      "kind": "internal",
      "handler": "build_test"
    },
    {
      "id": "github_status",
      "label": "狀態",
      "group": "github",
      "lane": "daily",
      "kind": "internal",
      "handler": "github_status"
    },
    {
      "id": "github_switch_branch",
      "label": "切換分支…",
      "group": "github",
      "lane": "daily",
      "kind": "internal",
      "handler": "github_switch_branch"
    },
    {
      "id": "github_commit",
      "label": "提交…",
      "group": "github",
      "lane": "daily",
      "kind": "internal",
      "handler": "github_commit"
    },
    {
      "id": "github_sync",
      "label": "同步（pull）",
      "group": "github",
      "lane": "daily",
      "kind": "internal",
      "handler": "github_sync",
      "requiresGithub": true,
      "confirm": "將自 remote fetch 並 pull --rebase 目前分支。確定？"
    },
    {
      "id": "github_publish",
      "label": "發布（push）",
      "group": "github",
      "lane": "daily",
      "kind": "internal",
      "handler": "github_publish",
      "requiresGithub": true,
      "confirm": "將 push 目前分支到 remote。確定？"
    },
    {
      "id": "github_open",
      "label": "開啟倉庫",
      "group": "github",
      "lane": "collab",
      "kind": "internal",
      "handler": "github_open",
      "requiresGithub": true
    },
    {
      "id": "github_pr",
      "label": "建立／開啟 PR",
      "group": "github",
      "lane": "collab",
      "kind": "internal",
      "handler": "github_pr",
      "requiresGithub": true
    },
    {
      "id": "github_release",
      "label": "發行 Release…",
      "group": "github",
      "lane": "ship",
      "kind": "internal",
      "handler": "github_release",
      "requiresGithub": true
    },
    {
      "id": "github_releases",
      "label": "Release 列表",
      "group": "github",
      "lane": "ship",
      "kind": "internal",
      "handler": "github_releases",
      "requiresGithub": true
    },
    {
      "id": "github_open_releases",
      "label": "開啟 Releases",
      "group": "github",
      "lane": "ship",
      "kind": "internal",
      "handler": "github_open_releases",
      "requiresGithub": true
    },
    {
      "id": "github_ci_scaffold",
      "label": "補齊 CI workflow…",
      "group": "github",
      "lane": "ship",
      "kind": "internal",
      "handler": "github_ci_scaffold",
      "confirm": "將在 .github/workflows/ci.yml 寫入建置／測試骨架（既有檔不覆蓋）。請審查後再提交。控制台不會代跑 Actions。確定？"
    },
    {
      "id": "github_actions",
      "label": "Actions 狀態…",
      "group": "github",
      "lane": "ship",
      "kind": "internal",
      "handler": "github_actions",
      "requiresGithub": true
    },
    {
      "id": "github_clone",
      "label": "從遠端開啟…",
      "group": "github",
      "lane": "setup",
      "kind": "internal",
      "handler": "github_clone"
    },
    {
      "id": "github_settings",
      "label": "GitHub 設定…",
      "group": "github",
      "lane": "setup",
      "kind": "internal",
      "handler": "github_settings"
    },
    {
      "id": "deploy_settings",
      "label": "部署設定…",
      "group": "deploy",
      "kind": "internal",
      "handler": "deploy_settings"
    },
    {
      "id": "deploy_status",
      "label": "部署狀態",
      "group": "deploy",
      "kind": "internal",
      "handler": "deploy_status",
      "requiresDeploy": true
    },
    {
      "id": "deploy_open",
      "label": "開啟線上",
      "group": "deploy",
      "kind": "internal",
      "handler": "deploy_open",
      "requiresDeploy": true
    },
    {
      "id": "deploy_ci_hint",
      "label": "部署說明",
      "group": "deploy",
      "kind": "internal",
      "handler": "deploy_ci_hint",
      "requiresDeploy": true
    },
    {
      "id": "docs_scaffold",
      "label": "建立／補齊體系…",
      "group": "docs",
      "kind": "internal",
      "handler": "docs_scaffold"
    },
    {
      "id": "docs_open_folder",
      "label": "開啟 docs 資料夾",
      "group": "docs",
      "kind": "internal",
      "handler": "docs_open_folder"
    },
    {
      "id": "docs_ai_fill",
      "label": "AI 補齊…",
      "group": "docs",
      "kind": "internal",
      "handler": "docs_ai_fill"
    },
    {
      "id": "docs_serve",
      "label": "本機網站預覽（目前這頁）",
      "group": "docs",
      "kind": "internal",
      "handler": "docs_serve"
    },
    {
      "id": "docs_open_pages",
      "label": "開啟線上文件",
      "group": "docs",
      "kind": "internal",
      "handler": "docs_open_pages",
      "requiresGithub": true
    },
    {
      "id": "docs_enable_pages",
      "label": "啟用 GitHub Pages",
      "group": "docs",
      "kind": "internal",
      "handler": "docs_enable_pages",
      "requiresGithub": true
    },
    {
      "id": "docs_publish_pages",
      "label": "同步到 GitHub Pages（push）",
      "group": "docs",
      "kind": "internal",
      "handler": "docs_publish_pages",
      "requiresGithub": true,
      "confirm": "將 push 目前分支。推到 main 後 Actions 會發佈文件站。確定？"
    }
  ]
}
