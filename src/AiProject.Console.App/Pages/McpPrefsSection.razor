@using AiProject.Console.Core.Agents
@using AiProject.Console.Core.Stack

<div class="mcp-prefs">
    @if (Section == "mcp")
    {
    <p class="hint">本控制台負責本機堆疊（狀態、編譯、啟停、Log）。這裡把其他 MCP 寫進專案 <code>.cursor/mcp.json</code>，讓 Agent 並排使用 GitHub、套件文件或公司內部閘道。不是只能三個：選建議範本，或選「自訂」填命令／URL。Agent 呼叫本控制台（含被拒）會出現在 MCP 審計視窗（摘要列「MCP 拒絕」）。</p>

    <section class="mcp-block" aria-labelledby="mcp-refs-title">
        <div class="mcp-block-head">
            <strong id="mcp-refs-title">已引用的 MCP</strong>
            <span class="hint">@(S.HasProject ? $"專案 .cursor/mcp.json · 已加入 {S.LinkedMcpCount}" : "開啟專案後顯示")</span>
        </div>

        <ul class="mcp-ref-list">
            @foreach (var mcp in S.ProjectMcpServers)
            {
                <li class="@(mcp.Linked ? "is-on" : "is-off") @(mcp.Suggested && !mcp.Linked ? "is-suggested" : null)">
                    <span class="mcp-dot @(mcp.Linked ? "on" : "off")" aria-hidden="true"></span>
                    <div class="mcp-ref-main">
                        <span class="mcp-ref-title">@mcp.Title</span>
                        <span class="hint">@mcp.Id · @mcp.Hint</span>
                    </div>
                    <div class="mcp-ref-actions">
                        @if (mcp.Linked)
                        {
                            <span class="mcp-badge on">已加入</span>
                            <button class="btn-link" type="button" disabled="@(!S.HasProject)" @onclick="() => S.RemoveMcpFromProject(mcp.Id)">移除</button>
                        }
                        else
                        {
                            <span class="mcp-badge @(mcp.Ours ? null : "muted")">@(mcp.Ours ? "未加入" : "建議")</span>
                            <button class="btn-link" type="button" disabled="@(!S.HasProject)" @onclick="() => S.WriteMcpServer(mcp.Id)">加入</button>
                        }
                    </div>
                </li>
            }
        </ul>
        <p class="hint">
            @(S.HasProject
                ? "此清單讀專案 .cursor/mcp.json（含你自訂加入的）。使用者全域 mcp.json 不會列在這裡。"
                : "尚未開啟專案。開啟後會讀取並寫入專案 .cursor/mcp.json；也可先複製本控制台設定貼到使用者全域。")
        </p>

        <div class="field mcp-add">
            <span>加入 MCP</span>
            <div class="field-inline">
                <select aria-label="選擇要加入的 MCP" value="@S.AddMcpId" @onchange="OnAddMcp">
                    @foreach (var mcp in S.AddableMcpServers)
                    {
                        <option value="@mcp.Id">@(mcp.Id == McpLaunch.CustomPickerId ? mcp.Title : $"{mcp.Title}（{mcp.Id}）")</option>
                    }
                </select>
                <button class="btn-primary" type="button" disabled="@(!S.CanAddSelectedMcp)" @onclick="S.WriteMcpConfigToProject">
                    @S.AddMcpButtonLabel
                </button>
            </div>
        </div>
        @if (S.SelectedMcpIsCustom)
        {
            <div class="mcp-custom">
                <div class="field">
                    <span>識別名稱</span>
                    <input value="@S.CustomMcpId" @oninput="OnCustomId" placeholder="例如 sentry 或 company-monitor" />
                </div>
                <div class="field">
                    <span>啟動方式</span>
                    <select aria-label="自訂 MCP 啟動方式" value="@S.CustomMcpKind" @onchange="OnCustomKind">
                        <option value="command">本機命令（stdio）</option>
                        <option value="url">遠端 URL</option>
                    </select>
                </div>
                @if (S.CustomMcpKind == "url")
                {
                    <div class="field">
                        <span>URL</span>
                        <input value="@S.CustomMcpUrl" @oninput="OnCustomUrl" placeholder="https://…" />
                    </div>
                }
                else
                {
                    <div class="field">
                        <span>命令</span>
                        <input value="@S.CustomMcpCommand" @oninput="OnCustomCommand" placeholder="npx 或 docker 或完整路徑" />
                    </div>
                    <div class="field">
                        <span>參數</span>
                        <input value="@S.CustomMcpArgs" @oninput="OnCustomArgs" placeholder="例如 -y @@upstash/context7-mcp" />
                    </div>
                }
            </div>
        }
        <div class="row">
            <button class="btn-sec" type="button" @onclick="S.CopyMcpConfigAsync">複製本控制台設定</button>
            <button class="btn-sec" type="button" disabled="@(!S.HasProject)" @onclick="S.OpenMcpConfig">開啟 mcp.json</button>
        </div>
    </section>
    }

    @if (Section == "tools")
    {
    <section class="mcp-block" aria-labelledby="mcp-tools-title">
        <div class="mcp-block-head">
            <strong id="mcp-tools-title">工具權限</strong>
            <span class="hint">Agent 可呼叫的本控制台工具</span>
        </div>

        <div class="field">
            <span>模式</span>
            <select aria-label="工具權限模式" value="@S.McpToolMode" @onchange="OnMode">
                <option value="all">全部可用</option>
                <option value="readonly">唯讀（只能看狀態／Log）</option>
                <option value="custom">自訂白名單</option>
            </select>
        </div>

        @if (S.McpToolMode == "custom")
        {
            <div class="field mcp-add">
                <span>加入工具</span>
                <div class="field-inline">
                    <select aria-label="選擇要加入的工具" value="@S.AddToolName" @onchange="OnAddToolName" disabled="@(!S.McpToolsToAdd.Any())">
                        @if (!S.McpToolsToAdd.Any())
                        {
                            <option value="">已全部加入</option>
                        }
                        @foreach (var tool in S.McpToolsToAdd)
                        {
                            <option value="@tool.Name">@StackToolRouter.DisplayTitle(tool.Name)（@tool.Name）</option>
                        }
                    </select>
                    <button class="btn-sec" type="button" disabled="@(!S.McpToolsToAdd.Any())" @onclick="() => S.AddMcpTool()">加入</button>
                </div>
            </div>
        }

        @if (!S.VisibleMcpTools.Any())
        {
            <p class="hint mcp-empty">尚未選擇工具。請用上方下拉加入。</p>
        }
        else
        {
            <ul class="mcp-tool-list">
                @foreach (var tool in S.VisibleMcpTools)
                {
                    var locked = S.McpToolAccessLocked(tool.Name);
                    <li class="mcp-tool-row">
                        <div class="mcp-ref-main">
                            <span class="mcp-ref-title">@StackToolRouter.DisplayTitle(tool.Name)</span>
                            <span class="hint"><code>@tool.Name</code></span>
                        </div>
                        <div class="mcp-tool-actions">
                            <select aria-label="@(tool.Name + " 權限")"
                                    value="@S.GetMcpToolAccess(tool.Name)"
                                    disabled="@locked"
                                    @onchange="e => OnToolAccess(tool.Name, e)">
                                <option value="allow">允許</option>
                                <option value="confirm">需確認</option>
                                @if (S.McpToolMode != "custom")
                                {
                                    <option value="deny">禁止</option>
                                }
                            </select>
                            @if (S.McpToolMode == "custom")
                            {
                                <button class="btn-link" type="button" disabled="@(S.VisibleMcpTools.Count <= 1)" @onclick="() => S.RemoveMcpTool(tool.Name)">移除</button>
                            }
                        </div>
                    </li>
                }
            </ul>
        }

        @if (S.ProjectHasMcpPolicy)
        {
            <p class="hint">此專案已有 <code>.ai_project/mcp-policy.json</code>，會覆蓋這裡的權限。</p>
        }
        <div class="row">
            <button class="btn-link" type="button" disabled="@(!S.HasProject)" @onclick="S.WriteMcpPolicyToProject">寫入專案政策範本</button>
        </div>
    </section>
    }

    @if (Section == "ask")
    {
    <section class="mcp-block" aria-labelledby="ask-title">
        <div class="mcp-block-head">
            <strong id="ask-title">專案問答</strong>
            <span class="hint">控制台內對談 · OpenAI 相容</span>
        </div>
        <p class="hint">點範本帶入網址與模型，再按「測試連線」確認來源。清單只列出支援工具呼叫的模型。本機 Ollama 的建議模型可一鍵 pull。</p>

        <div class="field field-top">
            <span>來源範本</span>
            <div class="ask-provider-chips" role="list">
                @foreach (var p in ProjectAskProviders.Catalog)
                {
                    <button type="button" class="ask-chip @(S.AskProviderId == p.Id ? "is-on" : null)" role="listitem"
                            title="@p.Hint" @onclick="@(() => S.ApplyAskProvider(p.Id))">
                        @p.Title
                    </button>
                }
            </div>
        </div>
        <p class="hint">@ProjectAskProviders.Get(S.AskProviderId).Hint</p>

        @if (S.AskSources.Count > 0)
        {
            <div class="field mcp-add">
                <span>已記住</span>
                <div class="field-inline">
                    <select aria-label="已記住的來源" value="@S.AskActiveSourceId" @onchange="OnAskSource">
                        @if (string.IsNullOrEmpty(S.AskActiveSourceId))
                        {
                            <option value="">目前尚未記住這組</option>
                        }
                        @foreach (var src in S.AskSources)
                        {
                            <option value="@src.Id">@src.Title · @src.Model</option>
                        }
                    </select>
                    <button class="btn-link" type="button" disabled="@(string.IsNullOrEmpty(S.AskActiveSourceId))"
                            @onclick="@(() => S.RemoveAskSource(S.AskActiveSourceId))">刪除</button>
                </div>
            </div>
        }

        <div class="field">
            <span>Base URL</span>
            <input value="@S.AskBaseUrl" @oninput="OnAskUrl" placeholder="http://127.0.0.1:11434/v1" />
        </div>
        <div class="field">
            <span>API key</span>
            <input value="@S.AskApiKey" @oninput="OnAskKey" placeholder="@(ProjectAskProviders.Get(S.AskProviderId).NeedsApiKey ? "必填" : "本機可空白")" />
        </div>
        <div class="field">
            <span>模型</span>
            <input value="@S.AskModel" @oninput="OnAskModel" list="ask-models" placeholder="llama3.2" />
        </div>
        @if (!string.IsNullOrWhiteSpace(S.AskModel) && !ProjectAskModelSupport.SupportsTools(S.AskModel))
        {
            <p class="hint ask-probe is-fail">@ProjectAskModelSupport.RejectReason(S.AskModel)</p>
        }
        <datalist id="ask-models">
            @foreach (var m in S.AskModelChoices)
            {
                <option value="@m"></option>
            }
        </datalist>
        @if (S.AskProbeModels.Count > 0)
        {
            <div class="ask-model-picks" role="list">
                @foreach (var m in S.AskProbeModels.Take(8))
                {
                    <button type="button" class="ask-chip @(string.Equals(S.AskModel, m, StringComparison.OrdinalIgnoreCase) ? "is-on" : null)"
                            role="listitem" @onclick="@(() => S.SetAskModel(m))">@m</button>
                }
            </div>
        }
        @if (S.AskCanPull && (S.AskPullModels.Count > 0 || S.AskPullBusy))
        {
            <p class="hint ask-pull-label">尚未安裝的建議模型，可直接 pull 到本機 Ollama：</p>
            <div class="ask-model-picks" role="list">
                @foreach (var m in S.AskPullModels)
                {
                    <button type="button" class="ask-chip is-suggest @(string.Equals(S.AskPullModel, m, StringComparison.OrdinalIgnoreCase) ? "is-on" : null)"
                            role="listitem" disabled="@(S.AskPullBusy || S.AskProbeBusy)"
                            title="@("ollama pull " + m)"
                            @onclick="@(() => S.PullAskModelAsync(m))">
                        pull @m
                    </button>
                }
            </div>
        }
        <div class="row ask-probe-row">
            <button class="btn-sec" type="button" disabled="@(S.AskProbeBusy || S.AskPullBusy || string.IsNullOrWhiteSpace(S.AskBaseUrl))" @onclick="S.ProbeAskAsync">
                @(S.AskProbeBusy ? "測試中…" : "測試連線")
            </button>
            <button class="btn-sec" type="button" disabled="@string.IsNullOrWhiteSpace(S.AskBaseUrl)" @onclick="S.RememberAskSource" title="儲存偏好設定時一併寫入">記住目前</button>
            @if (S.AskPullBusy)
            {
                <button class="btn-link" type="button" @onclick="S.CancelAskPull">取消下載</button>
            }
        </div>
        @if (!string.IsNullOrEmpty(S.AskPullMessage))
        {
            <p class="hint ask-probe @S.AskPullTone">@S.AskPullMessage</p>
        }
        @if (!string.IsNullOrEmpty(S.AskProbeMessage))
        {
            <p class="hint ask-probe @S.AskProbeTone">@S.AskProbeMessage</p>
        }
    </section>
    }
</div>

@code {
    [Parameter, EditorRequired] public ConsoleSession S { get; set; } = default!;

    [Parameter] public string Section { get; set; } = "mcp";

    void OnMode(ChangeEventArgs e) => S.SetMcpToolMode(e.Value?.ToString() ?? "all");

    void OnAddMcp(ChangeEventArgs e) => S.SetAddMcpId(e.Value?.ToString());

    void OnCustomKind(ChangeEventArgs e) => S.SetCustomMcpKind(e.Value?.ToString() ?? "command");

    void OnCustomId(ChangeEventArgs e) => S.SetCustomMcpId(e.Value?.ToString() ?? "");

    void OnCustomCommand(ChangeEventArgs e) => S.SetCustomMcpCommand(e.Value?.ToString() ?? "");

    void OnCustomArgs(ChangeEventArgs e) => S.SetCustomMcpArgs(e.Value?.ToString() ?? "");

    void OnCustomUrl(ChangeEventArgs e) => S.SetCustomMcpUrl(e.Value?.ToString() ?? "");

    void OnAddToolName(ChangeEventArgs e) => S.AddToolName = e.Value?.ToString() ?? "";

    void OnToolAccess(string name, ChangeEventArgs e) =>
        S.SetMcpToolAccess(name, e.Value?.ToString() ?? "allow");

    void OnAskUrl(ChangeEventArgs e) => S.SetAskBaseUrl(e.Value?.ToString() ?? "");

    void OnAskKey(ChangeEventArgs e) => S.SetAskApiKey(e.Value?.ToString() ?? "");

    void OnAskModel(ChangeEventArgs e) => S.SetAskModel(e.Value?.ToString() ?? "");

    void OnAskSource(ChangeEventArgs e) => S.ApplyAskSource(e.Value?.ToString());
}
