@using AiProject.Console.Core

<div class="menu @(Open == Key ? "open" : null)">
    <button class="btn-sec" disabled="@Busy" title="@(Busy ? DisabledTitle : Title)" @onclick="Toggle">@Title</button>
    <div class="menu-list">
        @foreach (var a in Actions)
        {
            <button disabled="@Busy" title="@(Busy ? DisabledTitle : a.Label)" @onclick="@(() => Run(a))">@a.Label</button>
        }
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Key { get; set; } = "";
    [Parameter] public IEnumerable<ConsoleAction> Actions { get; set; } = [];
    [Parameter] public ConsoleSession Session { get; set; } = default!;
    [Parameter] public string? Open { get; set; }
    [Parameter] public EventCallback<string?> OpenChanged { get; set; }

    bool Busy => Session.JobBusy;
    string DisabledTitle => string.IsNullOrEmpty(Session.BusyReason) ? "忙碌中" : Session.BusyReason;

    async Task Toggle()
    {
        if (Busy)
            return;
        await OpenChanged.InvokeAsync(Open == Key ? null : Key);
    }

    async Task Run(ConsoleAction a)
    {
        if (Busy)
            return;
        await OpenChanged.InvokeAsync(null);
        await Session.OnActionAsync(a);
    }
}
