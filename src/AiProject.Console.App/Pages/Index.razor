@page "/"
@inject ConsoleSession S
@inject IJSRuntime Js
@implements IDisposable

<div class="shell">
    <div class="head">
        <img class="brand-mark" src="img/logo.svg" width="32" height="32" alt="" />
        <h1>AI_Project 控制台</h1>
        <span class="hint">通用本機堆疊 · GitHub／部署 · v@(AppInfo.Version)</span>
        <span class="grow"></span>
        <button class="btn-sec" @onclick="S.OpenPreferences">設定</button>
        <button class="btn-sec" disabled="@S.JobBusy" @onclick="S.CheckUpdateAsync">檢查更新</button>
        <button class="btn-danger" @onclick="S.ExitAsync">離開</button>
    </div>

    @if (S.UpdateAvailable is not null)
    {
        <div class="update-banner">
            <span>發現新版本 @S.UpdateAvailable.Tag（目前 v@(AppInfo.Version)）</span>
            <span class="grow"></span>
            <button class="btn-primary" disabled="@S.JobBusy" @onclick="S.ApplyUpdateAsync">立即更新</button>
            <button class="btn-sec" @onclick="S.OpenUpdatePage">查看說明</button>
            <button class="btn-sec" @onclick="S.DismissUpdate">稍後再說</button>
        </div>
    }

    <div class="card">
        <div class="row">
            <strong>@(S.Catalog?.Name ?? "尚未選擇專案")</strong>
            <span class="hint grow">@(S.Catalog?.Root ?? "啟動後請選擇專案目錄、從歷史載入，或從 GitHub 開啟。")</span>
            <select class="history" @key="HistorySelectValue" value="@HistorySelectValue" @onchange="OnRecent">
                <option value="">歷史專案</option>
                @foreach (var p in S.RecentProjects)
                {
                    <option value="@p">@System.IO.Path.GetFileName(p) — @p</option>
                }
            </select>
            <button class="btn-sec" @onclick="S.PickProjectAsync">選擇專案目錄…</button>
            <button class="btn-sec" @onclick="S.OpenCloneDialog">從 GitHub 開啟…</button>
            <button class="btn-sec" disabled="@(!S.HasProject || S.JobBusy)" @onclick="S.CloseProjectAsync">關閉專案</button>
            <label class="check">
                <input type="checkbox" checked="@S.RestoreLastProject" @onchange="e => S.SetRestoreLastProject((bool)(e.Value ?? false))" />
                啟動時還原上次專案
            </label>
            <label class="check">
                <input type="checkbox" checked="@S.OpenWithCursor" @onchange="e => S.SetOpenWithCursor((bool)(e.Value ?? false))" />
                同時開啟 @S.AgentDisplayName
            </label>
        </div>
    </div>

    <div class="card">
        <div class="row">
            <button class="btn-primary" disabled="@S.JobBusy" @onclick="S.StartAllAsync">啟動</button>
            <button class="btn-danger" disabled="@S.JobBusy" @onclick="S.StopAllAsync">停止全部</button>
            <span class="sep"></span>
            <div class="menu @(openMenu == "urls" ? "open" : null)">
                <button class="btn-sec" @onclick="@(() => Toggle("urls"))">開啟前端</button>
                <div class="menu-list">
                    <button @onclick="@(() => { S.OpenUrls(true); openMenu = null; })">開啟前端</button>
                    <button @onclick="@(() => { S.OpenUrls(false); openMenu = null; })">開啟全部 URL</button>
                </div>
            </div>
            <button class="btn-primary" @onclick="S.OpenUatDialog">UAT 求救</button>
            <span class="sep"></span>
            <button class="btn-sec" @onclick="S.Doctor">環境體檢</button>
            <span class="sep"></span>
            <ActionMenu Title="建置" Actions="S.BuildActions" Session="S" @bind-Open="openMenu" Key="build" />
            <ActionMenu Title="GitHub" Actions="S.GithubActions" Session="S" @bind-Open="openMenu" Key="github" />
            <ActionMenu Title="部署" Actions="S.DeployActions" Session="S" @bind-Open="openMenu" Key="deploy" />
        </div>
    </div>

    <div class="summary">
        <span>@S.ReadyText</span>
        @if (S.HasProject)
        {
            <button type="button" class="duty-chip @(S.StaleProjectCount > 0 ? "is-warn" : "is-ok")" @onclick="S.ShowStaleProjects">
                需重編 @S.StaleProjectCount
            </button>
            <button type="button" class="duty-chip @(S.AuditFailCount > 0 ? "is-warn" : "is-ok")" @onclick="@(() => S.SetRightTab("audit"))">
                MCP 拒絕 @S.AuditFailCount
            </button>
            @if (!string.IsNullOrEmpty(S.DutyAttention))
            {
                <span class="duty-attn @(S.DutyOk ? "status-on" : "warn")">@S.DutyAttention</span>
            }
        }
        @if (!string.IsNullOrEmpty(S.GitStatusText))
        {
            <span class="git">@S.GitStatusText</span>
            @if (S.HasUncommitted)
            {
                <button class="btn-link" disabled="@S.JobBusy" @onclick="S.OpenCommitDialogAsync">提交…</button>
            }
        }
        <span class="job">@S.JobText</span>
        @if (!string.IsNullOrEmpty(S.WarnText))
        {
            <span class="warn">@S.WarnText</span>
        }
    </div>

    <div class="split" id="split-view">
        <div class="pane">
            <div class="tabs">
                <div class="tab @(S.LeftTab == "svc" ? "active" : null)" title="連點：全部展開／收合" @onclick="@(() => S.LeftTab = "svc")" @ondblclick="S.ToggleAllServiceGroups">
                    服務 <span class="badge">@S.ReadyCount/@S.ServiceCount</span>
                </div>
                <div class="tab @(S.LeftTab == "prj" ? "active" : null)" title="連點：全部展開／收合" @onclick="@(() => S.LeftTab = "prj")" @ondblclick="S.ToggleAllProjectGroups">
                    專案 <span class="badge">@(S.StaleProjectCount > 0 ? $"{S.StaleProjectCount} 需重編" : $"{S.Projects.Count}")</span>
                </div>
            </div>
            <div class="pane-body">
                @if (S.LeftTab == "svc")
                {
                    @if (S.Catalog is null || S.Catalog.Services.Count == 0)
                    {
                        <p class="hint">沒有對外服務。可放置 ai-project.json，或確認 launchSettings 有 applicationUrl。</p>
                    }
                    else
                    {
                        @foreach (var g in S.ServiceGroups)
                        {
                            var svcCollapsed = S.IsServiceGroupCollapsed(g.Key);
                            <button type="button" class="group-label @(svcCollapsed ? "collapsed" : null)" title="展開／收合" aria-expanded="@(!svcCollapsed)" @onclick="@(() => S.ToggleServiceGroup(g.Key))">
                                <span class="group-chevron" aria-hidden="true"></span>
                                <span>@g.Key</span>
                                <span class="group-count">@g.Count()</span>
                            </button>
                            @if (!svcCollapsed)
                            {
                            @foreach (var svc in g)
                            {
                                var on = S.Health.GetValueOrDefault(svc.Id);
                                <div class="svc @(S.SelectedServiceId == svc.Id ? "sel" : null)" @onclick="@(() => S.SelectService(svc.Id))">
                                    <span class="@(on ? "status-on" : "status-off")">@(on ? "線上" : "離線")</span>
                                    <span>@svc.Label</span>
                                    <span class="hint">@(svc.Port?.ToString() ?? "-")</span>
                                    <span>
                                        @if (!string.IsNullOrEmpty(svc.OpenUrl))
                                        {
                                            <button class="btn-link" @onclick:stopPropagation="true" @onclick="@(() => S.OpenServiceUrl(svc))">開啟</button>
                                        }
                                        @if (!string.IsNullOrEmpty(svc.HostedBy))
                                        {
                                            <span class="hint">隨 @svc.HostedBy</span>
                                        }
                                        else
                                        {
                                            @if (!on)
                                            {
                                                <button class="btn-link" @onclick:stopPropagation="true" @onclick="@(() => S.StartOneAsync(svc))">啟動</button>
                                            }
                                            <button class="btn-link" @onclick:stopPropagation="true" @onclick="@(() => S.RestartOneAsync(svc))">重啟</button>
                                            <button class="btn-link" @onclick:stopPropagation="true" @onclick="@(() => S.StopOneAsync(svc))">停止</button>
                                        }
                                        @if (S.StartErrors.TryGetValue(svc.Id, out var startErr))
                                        {
                                            <span class="svc-err" title="@startErr">失敗</span>
                                        }
                                    </span>
                                </div>
                            }
                            }
                        }
                    }
                }
                else
                {
                    <div class="row">
                        <label class="check"><input type="checkbox" checked="@S.StaleOnly" @onchange="e => { S.StaleOnly = (bool)(e.Value ?? false); }" /> 只看需重編</label>
                        <button class="btn-sec" @onclick="S.RefreshBuildStatesAsync">刷新</button>
                    </div>
                    <div class="prj-list">
                    @foreach (var g in S.ProjectGroups)
                    {
                        var prjCollapsed = S.IsProjectGroupCollapsed(g.Key);
                        <button type="button" class="group-label @(prjCollapsed ? "collapsed" : null)" title="展開／收合" aria-expanded="@(!prjCollapsed)" @onclick="@(() => S.ToggleProjectGroup(g.Key))">
                            <span class="group-chevron" aria-hidden="true"></span>
                            <span>@g.Key</span>
                            <span class="group-count">@g.Count()</span>
                        </button>
                        @if (!prjCollapsed)
                        {
                        @foreach (var p in g)
                        {
                            var kind = BuildFreshness.RowKind(p);
                            var badge = BuildFreshness.BadgeText(p);
                            var ago = BuildFreshness.FormatAgo(p.LastBuildUtc);
                            <div class="prj prj-@kind" title="@p.Reason">
                                <span class="prj-name">@p.Name</span>
                                <span class="meta">@ProjectMeta(p, ago)</span>
                                <span class="badge-stale badge-@kind">@badge</span>
                                <button class="btn-link" @onclick="@(() => S.BuildOneAsync(p.Path))">編譯</button>
                            </div>
                        }
                        }
                    }
                    </div>
                    @if (!S.VisibleProjects.Any())
                    {
                        <p class="hint">@(S.Catalog is null ? "請先選擇專案目錄。" : "沒有專案。")</p>
                    }
                }
            </div>
        </div>
        <div class="split-gutter" title="拖拉調整寬度，連點還原各半"></div>
        <div class="pane">
            <div class="tabs">
                <div class="tab @(S.RightTab == "log" ? "active" : null)" @onclick="@(() => S.SetRightTab("log"))">服務 Log</div>
                <div class="tab @(S.RightTab == "build" ? "active" : null)" @onclick="@(() => S.SetRightTab("build"))">建置輸出</div>
                <div class="tab @(S.RightTab == "audit" ? "active" : null)" @onclick="@(() => S.SetRightTab("audit"))">
                    MCP 審計
                    @if (S.AuditFailCount > 0)
                    {
                        <span class="badge badge-failed">@S.AuditFailCount</span>
                    }
                    else if (S.AuditTotal > 0)
                    {
                        <span class="badge">@S.AuditTotal</span>
                    }
                </div>
            </div>
            @if (S.RightTab == "log")
            {
                <div class="log-tools">
                    <strong>@S.LogTitle</strong>
                    <input class="log-search" placeholder="搜尋 Log…" value="@S.LogFilter" @oninput="OnLogFilter" />
                    <label class="check"><input type="checkbox" checked="@S.FollowLog" @onchange="e => S.FollowLog = (bool)(e.Value ?? false)" /> 跟隨最新</label>
                    <button class="btn-primary" disabled="@(!S.RuntimeHelpEnabled)" @onclick="S.OpenRuntimeHelp">執行求救</button>
                    <button class="btn-sec" @onclick="S.ReloadLog">重新載入</button>
                    <button class="btn-sec" @onclick="S.ClearLogView">清空顯示</button>
                    <button class="btn-sec" @onclick="S.OpenLogDir">開啟資料夾</button>
                </div>
                <pre class="log" id="log-view">@S.VisibleLogText</pre>
            }
            else if (S.RightTab == "build")
            {
                <div class="log-tools">
                    <strong>建置輸出</strong>
                    @if (!string.IsNullOrEmpty(S.BuildProgressText))
                    {
                        <span class="build-progress">@S.BuildProgressText</span>
                    }
                    @if (S.JobBusy && !string.IsNullOrEmpty(S.BuildCurrentName))
                    {
                        <span class="hint">@S.BuildCurrentName</span>
                    }
                    <button class="btn-primary" disabled="@(!S.CompileHelpEnabled)" @onclick="S.OpenCompileHelp">編譯求救</button>
                </div>
                <pre class="log" id="build-view">@S.BuildText</pre>
            }
            else
            {
                <div class="log-tools">
                    <strong>MCP 審計</strong>
                    <span class="hint">@(S.AuditTotal > 0 ? $"最近 {S.AuditEntries.Count}／共 {S.AuditTotal} 筆" : "尚無紀錄")</span>
                    <input class="log-search" placeholder="搜尋工具／參數…" value="@S.AuditFilter" @oninput="OnAuditFilter" />
                    <button class="btn-sec" disabled="@(!S.HasProject)" @onclick="S.RefreshAudit">重新載入</button>
                    <button class="btn-sec" disabled="@(!S.HasProject)" @onclick="S.OpenAuditDir">開啟檔案</button>
                </div>
                @if (!string.IsNullOrEmpty(S.AuditPolicyText))
                {
                    <p class="hint audit-policy">@S.AuditPolicyText</p>
                }
                <div class="audit-list">
                    @foreach (var e in S.VisibleAuditEntries)
                    {
                        <div class="audit-row @(e.Ok ? "ok" : "fail")" title="@(e.Error ?? e.ArgsText)">
                            <span class="audit-when">@e.WhenText</span>
                            <span class="@(e.Ok ? "status-on" : "status-off")">@(e.Ok ? "OK" : "拒")</span>
                            <span class="audit-tool">@e.Tool</span>
                            <span class="hint">@(e.Ms)ms</span>
                            <span class="audit-detail">
                                @if (!string.IsNullOrEmpty(e.Error))
                                {
                                    <span class="audit-err">@e.Error</span>
                                }
                                else if (!string.IsNullOrEmpty(e.ArgsText))
                                {
                                    <span class="audit-args">@e.ArgsText</span>
                                }
                            </span>
                        </div>
                    }
                    @if (!S.VisibleAuditEntries.Any())
                    {
                        <p class="hint">@(S.HasProject ? "Agent 尚未呼叫堆疊工具，或沒有符合搜尋的紀錄。" : "請先選擇專案目錄。")</p>
                    }
                </div>
            }
        </div>
    </div>
    <div class="foot">關閉控制台不會停止服務 · 狀態寫入選定專案的 .ai_project/</div>
</div>

@if (S.Dialog == "clone")
{
    <div class="overlay" @onclick="S.CloseDialog">
        <div class="dialog" @onclick:stopPropagation="true">
            <h2>從 GitHub 開啟</h2>
            <p class="hint">輸入遠端倉庫後會 clone 到本機，再當作專案開啟。若目錄已存在且是同一倉庫，會直接開啟。</p>
            <div class="field"><span>倉庫</span><input @bind="S.CloneSpec" placeholder="owner/repo 或 https://github.com/owner/repo.git" /></div>
            <div class="field">
                <span>本機目錄</span>
                <div class="field-inline">
                    <input @bind="S.CloneParent" placeholder="例如 E:\sjvann" />
                    <button class="btn-sec" @onclick="S.PickCloneParentAsync">瀏覽…</button>
                </div>
            </div>
            <div class="field"><span>資料夾名稱</span><input @bind="S.CloneFolder" placeholder="空白則用 repo 名稱" /></div>
            <div class="field"><span>分支（選填）</span><input @bind="S.CloneBranch" placeholder="預設分支" /></div>
            <div class="dialog-actions">
                <button class="btn-sec" @onclick="S.CloseDialog">取消</button>
                <button class="btn-primary" disabled="@S.JobBusy" @onclick="S.ConfirmCloneAsync">Clone 並開啟</button>
            </div>
        </div>
    </div>
}

@if (S.Dialog == "github")
{
    <div class="overlay" @onclick="S.CloseDialog">
        <div class="dialog" @onclick:stopPropagation="true">
            <h2>GitHub 設定</h2>
            <p class="hint">設定遠端倉庫後可提交、同步（pull）、發布（push）與發行 Release。可從 git remote 預填。</p>
            <div class="field"><span>Owner</span><input @bind="S.GithubDraft.Owner" /></div>
            <div class="field"><span>Repository</span><input @bind="S.GithubDraft.Repo" /></div>
            <div class="field"><span>Remote 名稱</span><input @bind="S.GithubDraft.Remote" /></div>
            <div class="field"><span>預設分支</span><input @bind="S.GithubDraft.DefaultBranch" /></div>
            <div class="field"><span>Remote URL</span><input @bind="S.GithubDraft.Url" /></div>
            <label class="check"><input type="radio" name="gsave" checked="@(S.GithubSaveTarget=="local")" @onchange="@(() => S.GithubSaveTarget="local")" /> 存到本機 settings</label>
            <label class="check"><input type="radio" name="gsave" checked="@(S.GithubSaveTarget=="manifest")" @onchange="@(() => S.GithubSaveTarget="manifest")" /> 寫入專案 ai-project.json</label>
            <label class="check"><input type="checkbox" checked="@S.GithubApplyRemote" @onchange="e => S.GithubApplyRemote = (bool)(e.Value ?? false)" /> 儲存後立即套用到 git remote</label>
            <div class="dialog-actions">
                <button class="btn-sec" @onclick="S.CloseDialog">取消</button>
                <button class="btn-primary" @onclick="S.SaveGithubAsync">儲存</button>
            </div>
        </div>
    </div>
}

@if (S.Dialog == "commit")
{
    <div class="overlay" @onclick="S.CloseDialog">
        <div class="dialog dialog-lg" @onclick:stopPropagation="true">
            <h2>提交變更</h2>
            <p class="hint">@S.CommitHint</p>
            <div class="field" style="align-items:start">
                <span>檔案</span>
                <pre class="change-list">@string.Join('\n', S.CommitChanges.Select(c => c.Display()))</pre>
            </div>
            <div class="field" style="align-items:start">
                <span>說明</span>
                <div>
                    <textarea @bind="S.CommitMessage" placeholder="例如：修正搜尋條件驗證。也可按「AI 建議」。" style="min-height:110px"></textarea>
                    <div class="btn-row">
                        <button class="btn-sec" disabled="@S.JobBusy" @onclick="S.SuggestCommitMessageAsync">AI 建議</button>
                    </div>
                    @if (!string.IsNullOrEmpty(S.CommitSuggestHint))
                    {
                        <p class="hint">@S.CommitSuggestHint</p>
                    }
                </div>
            </div>
            <label class="check"><input type="checkbox" checked="@S.CommitPushAfter" @onchange="e => S.CommitPushAfter = (bool)(e.Value ?? false)" /> 提交後發布（push）目前分支</label>
            <div class="dialog-actions">
                <button class="btn-sec" @onclick="S.CloseDialog">取消</button>
                <button class="btn-primary" disabled="@S.JobBusy" @onclick="S.ConfirmCommitAsync">提交</button>
            </div>
        </div>
    </div>
}

@if (S.Dialog == "release")
{
    <div class="overlay" @onclick="S.CloseDialog">
        <div class="dialog dialog-lg" @onclick:stopPropagation="true">
            <h2>發行 GitHub Release</h2>
            <p class="hint prewrap">@S.ReleaseHint</p>
            <div class="field">
                <span>版號／Tag</span>
                <div>
                    <input @bind="S.ReleaseTag" placeholder="v1.2.3" />
                    <div class="btn-row">
                        <button class="btn-sec" @onclick="@(() => S.BumpRelease("major"))">Major</button>
                        <button class="btn-sec" @onclick="@(() => S.BumpRelease("minor"))">Minor</button>
                        <button class="btn-sec" @onclick="@(() => S.BumpRelease("patch"))">Patch</button>
                    </div>
                </div>
            </div>
            <div class="field"><span>標題</span><input @bind="S.ReleaseTitle" placeholder="空白則使用版號" /></div>
            <div class="field"><span>說明</span><textarea @bind="S.ReleaseNotes" placeholder="選填。勾選自動產生時，會作為補充說明加在前面。"></textarea></div>
            <div class="field"><span>目標</span><input @bind="S.ReleaseTarget" placeholder="分支或 SHA，空白＝目前 HEAD" /></div>
            <label class="check"><input type="checkbox" checked="@S.ReleaseGenerateNotes" @onchange="e => S.ReleaseGenerateNotes = (bool)(e.Value ?? false)" /> 由 GitHub 依提交／PR 自動產生說明</label>
            <label class="check"><input type="checkbox" checked="@S.ReleaseDraft" @onchange="e => S.ReleaseDraft = (bool)(e.Value ?? false)" /> 草稿（draft，先不公開）</label>
            <label class="check"><input type="checkbox" checked="@S.ReleasePrerelease" @onchange="e => S.ReleasePrerelease = (bool)(e.Value ?? false)" /> 預發行（prerelease，例如 beta／rc）</label>
            <label class="check"><input type="checkbox" checked="@S.ReleaseMakeLatest" @onchange="e => S.ReleaseMakeLatest = (bool)(e.Value ?? false)" /> 標為 Latest（正式發行時）</label>
            <div class="field" style="align-items:start">
                <span>附加檔案</span>
                <div>
                    @if (S.ReleaseAssets.Count == 0)
                    {
                        <p class="hint">選填。可附加安裝包、zip 等資產。</p>
                    }
                    @foreach (var f in S.ReleaseAssets)
                    {
                        <div class="row"><span class="grow hint">@f</span><button class="btn-link" @onclick="@(() => S.RemoveReleaseAsset(f))">移除</button></div>
                    }
                    <button class="btn-sec" @onclick="S.AddReleaseAssetAsync">加入檔案…</button>
                </div>
            </div>
            <div class="dialog-actions">
                <button class="btn-sec" @onclick="S.CloseDialog">取消</button>
                <button class="btn-primary" disabled="@S.JobBusy" @onclick="S.ConfirmReleaseAsync">發行</button>
            </div>
        </div>
    </div>
}

@if (S.Dialog == "deploy")
{
    var d = S.DeployDraft;
    <div class="overlay" @onclick="S.CloseDialog">
        <div class="dialog" @onclick:stopPropagation="true">
            <h2>部署設定</h2>
            <p class="hint">請先選擇發佈目標，再填寫該目標所需的屬性。</p>
            <div class="field">
                <span>發佈目標</span>
                <select @bind="d.Target">
                    @foreach (var t in DeployTargets.All)
                    {
                        <option value="@t.Key">@t.Label</option>
                    }
                </select>
            </div>
            <p class="hint">@(DeployTargets.Hints.GetValueOrDefault(d.NormalizedTarget()))</p>
            @if (d.NormalizedTarget() == DeployTargets.Gcp)
            {
                <div class="field"><span>Project ID</span><input @bind="d.Gcp.ProjectId" /></div>
                <div class="field"><span>Zone</span><input @bind="d.Gcp.Zone" /></div>
                <div class="field"><span>Instance</span><input @bind="d.Gcp.Instance" /></div>
                <div class="field"><span>Host</span><input @bind="d.Gcp.Host" /></div>
                <div class="field"><span>Workflow</span><input @bind="d.Gcp.Workflow" /></div>
            }
            else if (d.NormalizedTarget() == DeployTargets.Onprem)
            {
                <div class="field">
                    <span>協定</span>
                    <select @bind="d.Onprem.Protocol">
                        @foreach (var p in DeployTargets.Protocols)
                        {
                            <option value="@p.Key">@p.Value</option>
                        }
                    </select>
                </div>
                <div class="field"><span>主機</span><input @bind="d.Onprem.Host" /></div>
                <div class="field"><span>連接埠</span><input @bind="d.Onprem.Port" /></div>
                <div class="field"><span>帳號</span><input @bind="d.Onprem.User" /></div>
                <div class="field"><span>遠端路徑</span><input @bind="d.Onprem.RemotePath" /></div>
                <div class="field"><span>SSH 金鑰</span><input @bind="d.Onprem.KeyPath" /></div>
                <div class="field"><span>對外網址</span><input @bind="d.Onprem.OpenUrl" /></div>
            }
            else if (d.NormalizedTarget() == DeployTargets.Azure)
            {
                <div class="field"><span>Subscription</span><input @bind="d.Azure.SubscriptionId" /></div>
                <div class="field"><span>Resource Group</span><input @bind="d.Azure.ResourceGroup" /></div>
                <div class="field"><span>App Name</span><input @bind="d.Azure.AppName" /></div>
                <div class="field"><span>Region</span><input @bind="d.Azure.Region" /></div>
                <div class="field"><span>對外網址</span><input @bind="d.Azure.OpenUrl" /></div>
                <div class="field"><span>Workflow</span><input @bind="d.Azure.Workflow" /></div>
            }
            <label class="check"><input type="radio" name="dsave" checked="@(S.DeploySaveTarget=="local")" @onchange="@(() => S.DeploySaveTarget="local")" /> 存到本機 settings</label>
            <label class="check"><input type="radio" name="dsave" checked="@(S.DeploySaveTarget=="manifest")" @onchange="@(() => S.DeploySaveTarget="manifest")" /> 寫入專案 ai-project.json</label>
            <div class="dialog-actions">
                <button class="btn-sec" @onclick="S.CloseDialog">取消</button>
                <button class="btn-primary" @onclick="S.SaveDeploy">儲存</button>
            </div>
        </div>
    </div>
}

@if (S.Dialog == "uat")
