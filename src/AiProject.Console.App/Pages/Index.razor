@code {
    string? openMenu;

    string HistorySelectValue =>
        S.Catalog?.Root is { } root
            ? S.RecentProjects.FirstOrDefault(p => string.Equals(p, root, StringComparison.OrdinalIgnoreCase)) ?? ""
            : "";

    static string ProjectMeta(BuildState p, string ago)
    {
        var bits = new List<string>();
        if (!string.IsNullOrEmpty(p.Kind))
            bits.Add(p.Kind);
        if (!string.IsNullOrEmpty(p.Language))
            bits.Add(p.Language);
        if (!string.IsNullOrEmpty(ago))
            bits.Add(ago);
        return string.Join(" · ", bits);
    }

    protected override void OnInitialized()
    {
        S.Js = Js;
        S.Changed += OnChanged;
    }

    protected override async Task OnAfterRenderAsync(bool first)
    {
        await Js.InvokeVoidAsync("aiConsole.setTheme", S.Theme);
        if (first)
            await Js.InvokeVoidAsync("aiConsole.initSplitter", "split-view");
        if (S.FollowLog && S.RightTab == "log")
            await Js.InvokeVoidAsync("aiConsole.scrollToEnd", "log-view");
        if (S.RightTab == "build")
            await Js.InvokeVoidAsync("aiConsole.scrollToEnd", "build-view");
    }

    void OnChanged() => InvokeAsync(StateHasChanged);

    void Toggle(string key) => openMenu = openMenu == key ? null : key;

    async Task OnRecent(ChangeEventArgs e)
    {
        var path = e.Value?.ToString();
        if (!string.IsNullOrEmpty(path))
            await S.LoadRecentAsync(path);
    }

    void OnLogFilter(ChangeEventArgs e) => S.SetLogFilter(e.Value?.ToString() ?? "");

    void OnAuditFilter(ChangeEventArgs e) => S.SetAuditFilter(e.Value?.ToString() ?? "");

    void OnAgentProvider(ChangeEventArgs e) => S.OnAgentProviderChanged(e.Value?.ToString() ?? "cursor");

    void OnAgentCli(ChangeEventArgs e)
    {
        S.AgentCliPath = e.Value?.ToString() ?? "";
        S.RefreshAgentDetectUi();
    }

    void OnCustomCmd(ChangeEventArgs e)
    {
        S.CustomAgentCommand = e.Value?.ToString() ?? "";
        S.RefreshAgentDetectUi();
    }

    void OnCustomArgs(ChangeEventArgs e)
    {
        S.CustomAgentArgs = e.Value?.ToString() ?? "";
        S.RefreshAgentDetectUi();
    }

    void OnTheme(ChangeEventArgs e)
    {
        S.Theme = e.Value?.ToString() is "dark" ? "dark" : "light";
        _ = Js.InvokeVoidAsync("aiConsole.setTheme", S.Theme);
    }

    void OnMcpAllow(ChangeEventArgs e) => S.McpAllow = e.Value?.ToString() ?? "";

    void OnMcpDeny(ChangeEventArgs e) => S.McpDeny = e.Value?.ToString() ?? "";

    void OnMcpConfirm(ChangeEventArgs e) => S.McpConfirm = e.Value?.ToString() ?? "";

    public void Dispose() => S.Changed -= OnChanged;
}
