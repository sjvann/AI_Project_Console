            <div class="dialog-actions">
                <button class="btn-sec" disabled="@S.GithubAuthBusy" @onclick="S.CancelGithubLogin">取消並關閉專案</button>
                <button class="btn-primary" disabled="@S.GithubAuthBusy" @onclick="S.LoginGithubAsync">@(S.GithubAuthBusy ? "等待瀏覽器授權…" : "登入 GitHub")</button>
            </div>
        </div>
    </div>
}

@if (S.Dialog == "branch")
{
    <div class="overlay" @onclick="S.CloseDialog">
        <div class="dialog" @onclick:stopPropagation="true" role="dialog" aria-labelledby="branch-title" aria-modal="true">
            <h2 id="branch-title">切換分支</h2>
            <p class="hint">目前：@(S.GitBrief?.Branch ?? "（未知）")。工作區必須乾淨才能切換；切換後會立刻從遠端同步。</p>
            @if (!string.IsNullOrEmpty(S.BranchDialogHint))
            {
                <p class="hint">@S.BranchDialogHint</p>
            }
            <div class="branch-list" role="listbox" aria-label="分支清單">
                @if (S.BranchList.Count == 0)
                {
                    <p class="hint">尚無分支可選。</p>
                }
                else
                {
                    @foreach (var b in S.BranchList)
                    {
                        <button type="button"
                                class="branch-row @(b.IsCurrent ? "is-current" : null)"
                                disabled="@(S.JobBusy || b.IsCurrent || S.HasUncommitted)"
                                role="option"
                                aria-selected="@b.IsCurrent"
                                @onclick="@(() => S.SwitchToBranchAsync(b))">
                            <span class="branch-row-name">@b.Name</span>
                            <span class="hint">@b.Meta()</span>
                            @if (b.IsCurrent)
                            {
                                <span class="branch-now">目前</span>
                            }
                        </button>
                    }
                }
            </div>
            <div class="field">
                <span>新分支</span>
                <div class="field-inline">
                    <input @bind="S.NewBranchName" placeholder="例如 feat/login" disabled="@S.JobBusy" />
                    <button class="btn-sec" disabled="@S.JobBusy" @onclick="S.CreateBranchAsync">建立並切換</button>
                </div>
            </div>
            <div class="dialog-actions">
                <button class="btn-sec" @onclick="S.CloseDialog">關閉</button>
            </div>
        </div>
    </div>
}

@if (S.Dialog == "clone")
{
    <div class="overlay" @onclick="S.CloseDialog">
        <div class="dialog" @onclick:stopPropagation="true">
            <h2>從 GitHub 開啟</h2>
            <p class="hint">輸入遠端倉庫後會 clone 到本機，再當作專案開啟。若目錄已存在且是同一倉庫，會直接開啟。</p>
            <div class="field"><span>倉庫</span><input @bind="S.CloneSpec" placeholder="owner/repo 或 https://github.com/owner/repo.git" /></div>
            <div class="field">
                <span>本機目錄</span>
                <div class="field-inline">
                    <input @bind="S.CloneParent" placeholder="例如 E:\sjvann" />
                    <button class="btn-sec" @onclick="S.PickCloneParentAsync">瀏覽…</button>
                </div>
            </div>
            <div class="field"><span>資料夾名稱</span><input @bind="S.CloneFolder" placeholder="空白則用 repo 名稱" /></div>
            <div class="field"><span>分支（選填）</span><input @bind="S.CloneBranch" placeholder="預設分支" /></div>
            <div class="dialog-actions">
                <button class="btn-sec" @onclick="S.CloseDialog">取消</button>
                <button class="btn-primary" disabled="@S.JobBusy" @onclick="S.ConfirmCloneAsync">Clone 並開啟</button>
            </div>
        </div>
    </div>
}

@if (S.Dialog == "github")
{
    <div class="overlay" @onclick="S.CloseDialog">
        <div class="dialog" @onclick:stopPropagation="true">
            <h2>GitHub 設定</h2>
            <p class="hint">設定遠端倉庫後可提交、同步（pull）、發布（push）與發行 Release。可從 git remote 預填。</p>
            <div class="field"><span>Owner</span><input @bind="S.GithubDraft.Owner" /></div>
            <div class="field"><span>Repository</span><input @bind="S.GithubDraft.Repo" /></div>
            <div class="field"><span>Remote 名稱</span><input @bind="S.GithubDraft.Remote" /></div>
            <div class="field"><span>預設分支</span><input @bind="S.GithubDraft.DefaultBranch" /></div>
            <div class="field"><span>Remote URL</span><input @bind="S.GithubDraft.Url" /></div>
            <label class="check"><input type="radio" name="gsave" checked="@(S.GithubSaveTarget=="local")" @onchange="@(() => S.GithubSaveTarget="local")" /> 存到本機 settings</label>
            <label class="check"><input type="radio" name="gsave" checked="@(S.GithubSaveTarget=="manifest")" @onchange="@(() => S.GithubSaveTarget="manifest")" /> 寫入專案 ai-project.json</label>
            <label class="check"><input type="checkbox" checked="@S.GithubApplyRemote" @onchange="e => S.GithubApplyRemote = (bool)(e.Value ?? false)" /> 儲存後立即套用到 git remote</label>
            <div class="dialog-actions">
                <button class="btn-sec" @onclick="S.CloseDialog">取消</button>
                <button class="btn-primary" @onclick="S.SaveGithubAsync">儲存</button>
            </div>
        </div>
    </div>
}

@if (S.Dialog == "commit")
{
    <div class="overlay" @onclick="S.CloseDialog">
        <div class="dialog dialog-lg" @onclick:stopPropagation="true">
            <h2>提交變更</h2>
            <p class="hint">@S.CommitHint</p>
            <div class="field" style="align-items:start">
                <span>檔案</span>
                <pre class="change-list">@string.Join('\n', S.CommitChanges.Select(c => c.Display()))</pre>
            </div>
            <div class="field" style="align-items:start">
                <span>說明</span>
                <div>
                    <textarea @bind="S.CommitMessage" placeholder="例如：修正搜尋條件驗證。也可按「AI 建議」。" style="min-height:110px"></textarea>
                    <div class="btn-row">
                        <button class="btn-sec" disabled="@S.JobBusy" @onclick="S.SuggestCommitMessageAsync">AI 建議</button>
                    </div>
                    @if (!string.IsNullOrEmpty(S.CommitSuggestHint))
                    {
                        <p class="hint">@S.CommitSuggestHint</p>
                    }
                </div>
            </div>
            <label class="check"><input type="checkbox" checked="@S.CommitPushAfter" @onchange="e => S.CommitPushAfter = (bool)(e.Value ?? false)" /> 提交後發布（push）目前分支</label>
            <div class="dialog-actions">
                <button class="btn-sec" @onclick="S.CloseDialog">取消</button>
                <button class="btn-primary" disabled="@S.JobBusy" @onclick="S.ConfirmCommitAsync">提交</button>
            </div>
        </div>
    </div>
