@page "/"
@inject ConsoleSession S
@inject IJSRuntime Js
@implements IDisposable

<div class="shell">
    <div class="head">
        <img class="brand-mark" src="img/logo.svg" width="32" height="32" alt="" />
        <h1>AI_Project 控制台</h1>
        <span class="hint">通用本機堆疊 · GitHub／部署 · v@(AppInfo.Version)</span>
        <span class="grow"></span>
        <button class="btn-sec" @onclick="@(() => S.OpenPreferences())">設定</button>
        <button class="btn-sec" disabled="@S.JobBusy" @onclick="S.CheckUpdateAsync">檢查更新</button>
        @if (S.GithubLoggedIn)
        {
            <span class="gh-id" title="目前 GitHub 帳號">
                <span class="gh-id-dot" aria-hidden="true"></span>
                <span>@S.GithubAccount.Display()</span>
            </span>
            <button class="btn-sec" disabled="@S.GithubAuthBusy" title="登出 GitHub CLI 帳號" @onclick="S.LogoutGithubAsync">登出 GitHub</button>
        }
        <button class="btn-danger" @onclick="S.ExitAsync">離開</button>
    </div>

    @if (S.UpdateAvailable is not null)
    {
        <div class="update-banner">
            <span>發現新版本 @S.UpdateAvailable.Tag（目前 v@(AppInfo.Version)）</span>
            <span class="grow"></span>
            <button class="btn-primary" disabled="@S.JobBusy" @onclick="S.ApplyUpdateAsync">立即更新</button>
            <button class="btn-sec" @onclick="S.OpenUpdatePage">查看說明</button>
            <button class="btn-sec" @onclick="S.DismissUpdate">稍後再說</button>
        </div>
    }

    <div class="card">
        <div class="row">
            <strong>@(S.Catalog?.Name ?? "尚未選擇專案")</strong>
            @if (S.HasProject && S.GitBrief is not null)
            {
                <button type="button"
                        class="branch-chip @(S.GitBrief.IsClearToLeave ? "is-ok" : "is-warn")"
                        disabled="@S.JobBusy"
                        title="目前分支，點擊切換"
                        @onclick="S.OpenBranchDialogAsync">
                    <span class="branch-chip-label">分支</span>
                    <span class="branch-chip-name">@S.GitBrief.Branch</span>
                    <span class="branch-chip-caret" aria-hidden="true"></span>
                </button>
            }
            <span class="hint grow">@(S.Catalog?.Root ?? "啟動後請選擇專案目錄、從歷史載入，或從 GitHub 開啟。")</span>
            <select class="history" @key="HistorySelectValue" value="@HistorySelectValue" @onchange="OnRecent">
                <option value="">歷史專案</option>
                @foreach (var p in S.RecentProjects)
                {
                    <option value="@p">@System.IO.Path.GetFileName(p) — @p</option>
                }
            </select>
            <button class="btn-sec" @onclick="S.PickProjectAsync">選擇專案目錄…</button>
            <button class="btn-sec" @onclick="S.OpenCloneDialog">從 GitHub 開啟…</button>
            <button class="btn-sec" disabled="@(!S.HasProject || S.JobBusy)" @onclick="S.CloseProjectAsync">關閉專案</button>
            <label class="check">
                <input type="checkbox" checked="@S.RestoreLastProject" @onchange="e => S.SetRestoreLastProject((bool)(e.Value ?? false))" />
                啟動時還原上次專案
            </label>
            <label class="check">
                <input type="checkbox" checked="@S.OpenWithCursor" @onchange="e => S.SetOpenWithCursor((bool)(e.Value ?? false))" />
                同時開啟 @S.AgentDisplayName
            </label>
        </div>
    </div>

    <div class="card">
        <div class="row">
            <button class="btn-primary" disabled="@S.JobBusy" @onclick="S.StartAllAsync">啟動</button>
            <button class="btn-danger" disabled="@S.JobBusy" @onclick="S.StopAllAsync">停止全部</button>
            <span class="sep"></span>
            <div class="menu @(openMenu == "urls" ? "open" : null)">
                <button class="btn-sec" @onclick="@(() => Toggle("urls"))">開啟前端</button>
                <div class="menu-list">
                    <button @onclick="@(() => { S.OpenUrls(true); openMenu = null; })">開啟前端</button>
                    <button @onclick="@(() => { S.OpenUrls(false); openMenu = null; })">開啟全部 URL</button>
                </div>
            </div>
            <button class="btn-primary" @onclick="S.OpenUatDialog">UAT 求救</button>
            <span class="sep"></span>
            <ActionMenu Title="建置" Actions="S.BuildActions" Session="S" @bind-Open="openMenu" Key="build" />
            <span class="sep"></span>
            <ActionMenu Title="GitHub" Actions="S.GithubActions" Session="S" @bind-Open="openMenu" Key="github" />
            <ActionMenu Title="部署" Actions="S.DeployActions" Session="S" @bind-Open="openMenu" Key="deploy" />
            <ActionMenu Title="文件" Actions="S.DocsActions" Session="S" @bind-Open="openMenu" Key="docs" />
            <button class="btn-sec row-end" @onclick="S.Doctor">環境體檢</button>
        </div>
    </div>

    <div class="summary">
        <span>@S.ReadyText</span>
        @if (S.HasProject)
        {
            <button type="button" class="duty-chip @(S.StaleProjectCount > 0 ? "is-warn" : "is-ok")" @onclick="S.ShowStaleProjects">
                需重編 @S.StaleProjectCount
            </button>
            <button type="button" class="duty-chip @(S.AuditFailCount > 0 ? "is-warn" : "is-ok")" @onclick="@(() => S.SetRightTab("audit"))">
                MCP 拒絕 @S.AuditFailCount
            </button>
            @if (S.GithubManaged)
            {
                <button type="button" class="duty-chip @(S.AssignedIssues.Count > 0 ? "is-ok" : "is-wait")" @onclick="S.ShowTasks">
                    我的任務 @S.AssignedIssues.Count
                </button>
            }
            <button type="button" class="duty-chip @(S.DocsChipWarn ? "is-warn" : "is-ok")" title="專案文件（docs/）" @onclick="S.ShowDocs">
                @(S.Docs?.ChipText() ?? "文件 無文件")
            </button>
            @if (!string.IsNullOrEmpty(S.DutyAttention))
            {
                <span class="duty-attn @(S.DutyOk ? "status-on" : "warn")">@S.DutyAttention</span>
            }
        }
        @if (!string.IsNullOrEmpty(S.GitStatusText))
        {
            <button type="button" class="git git-btn" disabled="@S.JobBusy" title="切換分支" @onclick="S.OpenBranchDialogAsync">@S.GitStatusText</button>
            @if (S.HasUncommitted)
            {
                <button class="btn-link" disabled="@S.JobBusy" @onclick="S.OpenCommitDialogAsync">提交…</button>
            }
        }
        <span class="job">@S.JobText</span>
        @if (!string.IsNullOrEmpty(S.WarnText))
        {
            <span class="warn">@S.WarnText</span>
        }
    </div>

    <div class="split" id="split-view">
        <div class="pane">
            <div class="tabs" role="tablist" aria-label="服務、專案、文件與任務">
                <div class="tab @(S.LeftTab == "svc" ? "active" : null)" role="tab" tabindex="0" aria-selected="@(S.LeftTab == "svc")" title="連點：全部展開／收合" @onclick="@(() => S.LeftTab = "svc")" @ondblclick="S.ToggleAllServiceGroups" @onkeydown="@(e => OnLeftTabKey(e, "svc"))">
                    服務 <span class="badge">@S.ReadyCount/@S.ServiceCount</span>
                </div>
                <div class="tab @(S.LeftTab == "prj" ? "active" : null)" role="tab" tabindex="0" aria-selected="@(S.LeftTab == "prj")" title="連點：全部展開／收合" @onclick="@(() => S.LeftTab = "prj")" @ondblclick="S.ToggleAllProjectGroups" @onkeydown="@(e => OnLeftTabKey(e, "prj"))">
                    專案 <span class="badge">@(S.StaleProjectCount > 0 ? $"{S.StaleProjectCount} 需重編" : $"{S.Projects.Count}")</span>
                </div>
                <div class="tab @(S.LeftTab == "docs" ? "active" : null)" role="tab" tabindex="0" aria-selected="@(S.LeftTab == "docs")" title="專案 docs/" @onclick="S.ShowDocs" @onkeydown="@(e => OnLeftTabKey(e, "docs"))">
                    文件
                    @if (S.Docs is not null)
                    {
                        <span class="badge">@S.Docs.FileCount</span>
                    }
                </div>
                <div class="tab @(S.LeftTab == "task" ? "active" : null)" role="tab" tabindex="0" aria-selected="@(S.LeftTab == "task")" title="指派給我的 GitHub Issue" @onclick="S.ShowTasks" @onkeydown="@(e => OnLeftTabKey(e, "task"))">
                    任務
                    @if (S.GithubLoggedIn && S.GithubManaged)
                    {
                        <span class="badge">@S.AssignedIssues.Count</span>
                    }
                </div>
            </div>
            <div class="pane-body">
                @if (S.LeftTab == "svc")
                {
                    @if (S.Catalog is null || S.Catalog.Services.Count == 0)
                    {
                        <p class="hint">沒有對外服務。可放置 ai-project.json，或確認 launchSettings 有 applicationUrl。</p>
                    }
                    else
                    {
                        @foreach (var g in S.ServiceGroups)
                        {
                            var svcCollapsed = S.IsServiceGroupCollapsed(g.Key);
                            <button type="button" class="group-label @(svcCollapsed ? "collapsed" : null)" title="展開／收合" aria-expanded="@(!svcCollapsed)" @onclick="@(() => S.ToggleServiceGroup(g.Key))">
                                <span class="group-chevron" aria-hidden="true"></span>
                                <span>@g.Key</span>
                                <span class="group-count">@g.Count()</span>
                            </button>
                            @if (!svcCollapsed)
                            {
                            @foreach (var svc in g)
                            {
                                var on = S.Health.GetValueOrDefault(svc.Id);
                                <div class="svc @(S.SelectedServiceId == svc.Id ? "sel" : null)" @onclick="@(() => S.SelectService(svc.Id))">
                                    <span class="@(on ? "status-on" : "status-off")">@(on ? "線上" : "離線")</span>
                                    <span>@svc.Label</span>
                                    <span class="hint">@(svc.Port?.ToString() ?? "-")</span>
                                    <span>
                                        @if (!string.IsNullOrEmpty(svc.OpenUrl))
                                        {
                                            <button class="btn-link" @onclick:stopPropagation="true" @onclick="@(() => S.OpenServiceUrl(svc))">開啟</button>
                                        }
                                        @if (!string.IsNullOrEmpty(svc.HostedBy))
                                        {
                                            <span class="hint">隨 @svc.HostedBy</span>
                                        }
                                        else
                                        {
                                            @if (!on)
                                            {
                                                <button class="btn-link" @onclick:stopPropagation="true" @onclick="@(() => S.StartOneAsync(svc))">啟動</button>
                                            }
                                            <button class="btn-link" @onclick:stopPropagation="true" @onclick="@(() => S.RestartOneAsync(svc))">重啟</button>
                                            <button class="btn-link" @onclick:stopPropagation="true" @onclick="@(() => S.StopOneAsync(svc))">停止</button>
                                        }
                                        @if (S.StartErrors.TryGetValue(svc.Id, out var startErr))
                                        {
                                            <span class="svc-err" title="@startErr">失敗</span>
                                        }
                                    </span>
                                </div>
                            }
                            }
                        }
                    }
                }
                else if (S.LeftTab == "prj")
                {
                    <div class="row">
                        <label class="check"><input type="checkbox" checked="@S.StaleOnly" @onchange="e => { S.StaleOnly = (bool)(e.Value ?? false); }" /> 只看需重編</label>
                        <button class="btn-sec" @onclick="S.RefreshBuildStatesAsync">刷新</button>
                    </div>
                    <div class="prj-list">
                    @foreach (var g in S.ProjectGroups)
                    {
                        var prjCollapsed = S.IsProjectGroupCollapsed(g.Key);
                        <button type="button" class="group-label @(prjCollapsed ? "collapsed" : null)" title="展開／收合" aria-expanded="@(!prjCollapsed)" @onclick="@(() => S.ToggleProjectGroup(g.Key))">
                            <span class="group-chevron" aria-hidden="true"></span>
                            <span>@g.Key</span>
                            <span class="group-count">@g.Count()</span>
                        </button>
                        @if (!prjCollapsed)
                        {
                        @foreach (var p in g)
                        {
                            var kind = BuildFreshness.RowKind(p);
                            var badge = BuildFreshness.BadgeText(p);
                            var ago = BuildFreshness.FormatAgo(p.LastBuildUtc);
                            <div class="prj prj-@kind" title="@p.Reason">
                                <span class="prj-name">@p.Name</span>
                                <span class="meta">@ProjectMeta(p, ago)</span>
                                <span class="badge-stale badge-@kind">@badge</span>
                                <button class="btn-link" @onclick="@(() => S.BuildOneAsync(p.Path))">編譯</button>
                            </div>
                        }
                        }
                    }
                    </div>
                    @if (!S.VisibleProjects.Any())
                    {
                        <p class="hint">@(S.Catalog is null ? "請先選擇專案目錄。" : "沒有專案。")</p>
                    }
                }
                else if (S.LeftTab == "docs")
                {
                    <div class="row task-toolbar">
                        <span class="hint grow">@(S.Docs?.Label() ?? "尚未掃描")</span>
                        <button class="btn-sec" disabled="@(!S.HasProject || S.JobBusy)" @onclick="S.ScaffoldDocsAsync">建立體系</button>
                        <button class="btn-sec" disabled="@(!S.HasProject)" @onclick="@(() => S.OpenNewDocDialog())">新增文件</button>
                        <button class="btn-sec" disabled="@(!S.HasProject)" @onclick="@(() => S.RefreshDocs(true))">刷新</button>
                    </div>
                    @if (!string.IsNullOrEmpty(S.DocsHint))
                    {
                        <p class="hint">@S.DocsHint</p>
                    }
                    @if (S.Catalog is null)
                    {
                        <p class="hint">請先選擇專案目錄。文件規定都放在 docs/。</p>
                    }
                    else if (S.Docs is null || S.Docs.Files.Count == 0)
                    {
                        <p class="hint">還沒有 docs/。按「建立體系」產生標準 Markdown 骨架與 DocFX 設定。</p>
                    }
                    else
                    {
                        <div class="doc-tree" role="tree" aria-label="文件目錄">
                            <div class="doc-tree-root">docs/</div>
                            @foreach (var row in S.VisibleDocsTree)
                            {
                                var pad = 8 + row.Depth * 14;
                                if (row.IsFolder)
                                {
                                    var collapsed = S.IsDocFolderCollapsed(row.RelPath);
                                    <div class="doc-tree-line" style="padding-left: @(pad)px">
                                        <button type="button"
                                                class="doc-folder @(collapsed ? "collapsed" : null)"
                                                role="treeitem"
                                                aria-expanded="@(!collapsed)"
                                                title="展開／收合"
                                                @onclick="@(() => S.ToggleDocFolder(row.RelPath))">
                                            <span class="group-chevron" aria-hidden="true"></span>
                                            <span class="doc-folder-name">@row.Name/</span>
                                            <span class="group-count">@row.ChildCount</span>
                                        </button>
                                        <button type="button"
                                                class="btn-link doc-folder-add"
                                                title="在此目錄新增文件"
                                                @onclick="@(() => S.OpenNewDocDialog(row.RelPath))">新增</button>
                                    </div>
                                }
                                else if (row.File is { } f)
                                {
                                    <button type="button"
                                            class="doc-file @(f.RelPath == S.SelectedDocPath ? "sel" : null)"
                                            style="padding-left: @(pad)px"
                                            role="treeitem"
                                            aria-selected="@(f.RelPath == S.SelectedDocPath)"
                                            title="@f.RelPath"
                                            @onclick="@(() => S.SelectDocAsync(f.RelPath))">
                                        <span class="doc-file-name">@row.Name</span>
                                        <span class="hint">@f.Title</span>
                                        @if (f.IsStub)
                                        {
                                            <span class="doc-stub">待補</span>
                                        }
                                    </button>
                                }
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="row task-toolbar">
                        <span class="hint grow">@(S.GithubLoggedIn ? S.GithubAccount.Display() + " 的 Issue" : "GitHub 任務")</span>
                        <button class="btn-sec" disabled="@(S.IssuesBusy || !S.GithubLoggedIn || !S.GithubManaged)" @onclick="S.RefreshIssuesAsync">刷新</button>
                    </div>
                    @if (S.Catalog is null)
                    {
                        <p class="hint">請先選擇專案目錄。GitHub 管理的專案會在登入後顯示指派給你的 Issue。</p>
                    }
                    else if (!S.GithubManaged)
                    {
                        <p class="hint">此專案尚未接上 GitHub，沒有 Issue 任務。</p>
                    }
                    else if (!S.GithubLoggedIn)
                    {
                        <div class="task-empty">
                            <p class="hint">此專案由 GitHub 管理，請先登入才能看任務。</p>
                            <button class="btn-primary" disabled="@S.GithubAuthBusy" @onclick="S.LoginGithubAsync">登入 GitHub</button>
                        </div>
                    }
                    else
                    {
                        @if (!string.IsNullOrEmpty(S.IssuesHint))
                        {
                            <p class="hint">@S.IssuesHint</p>
                        }
                        <section class="task-section" aria-label="我的任務">
                            <h3 class="task-heading">我的任務 <span class="group-count">@S.AssignedIssues.Count</span></h3>
                            @if (S.AssignedIssues.Count == 0)
                            {
                                <p class="hint">目前沒有指派給你的 Issue。可從下方未指派清單接手。</p>
                            }
                            @foreach (var issue in S.AssignedIssues)
                            {
                                <div class="task-row">
                                    <span class="task-num">@issue.NumberText</span>
                                    <div class="task-main">
                                        <button type="button" class="task-title" title="在瀏覽器開啟" @onclick="@(() => S.OpenIssueUrl(issue))">@issue.Title</button>
                                        <span class="task-meta">
                                            @if (!string.IsNullOrEmpty(issue.LabelText))
                                            {
                                                <span>@issue.LabelText</span>
                                            }
                                            @if (!string.IsNullOrEmpty(issue.WhenText()))
                                            {
                                                <span>@issue.WhenText()</span>
                                            }
                                        </span>
                                    </div>
                                    <button class="btn-primary btn-compact" title="請後端 Agent 協助處理此 Issue" @onclick="@(() => S.OpenIssueHelp(issue))">請 Agent 協助</button>
                                </div>
                            }
                        </section>
                        <section class="task-section" aria-label="未指派">
                            <button type="button" class="group-label @(S.UnassignedCollapsed ? "collapsed" : null)" title="展開／收合未指派清單" aria-expanded="@(!S.UnassignedCollapsed)" @onclick="S.ToggleUnassignedIssues">
                                <span class="group-chevron" aria-hidden="true"></span>
                                <span>未指派</span>
                                <span class="group-count">@S.UnassignedIssues.Count</span>
                            </button>
                            @if (!S.UnassignedCollapsed)
                            {
                                @if (S.UnassignedIssues.Count == 0)
                                {
                                    <p class="hint">沒有未指派的 Issue。</p>
                                }
                                @foreach (var issue in S.UnassignedIssues)
                                {
                                    <div class="task-row task-open">
                                        <span class="task-num">@issue.NumberText</span>
                                        <div class="task-main">
                                            <button type="button" class="task-title" title="在瀏覽器開啟" @onclick="@(() => S.OpenIssueUrl(issue))">@issue.Title</button>
                                            <span class="task-meta">
                                                @if (!string.IsNullOrEmpty(issue.LabelText))
                                                {
                                                    <span>@issue.LabelText</span>
                                                }
                                                @if (!string.IsNullOrEmpty(issue.WhenText()))
                                                {
                                                    <span>@issue.WhenText()</span>
                                                }
                                            </span>
                                        </div>
                                        <button class="btn-sec btn-compact" title="把這則 Issue 指派給自己" @onclick="@(() => S.AcceptIssueAsync(issue.Number))">接受</button>
                                    </div>
                                }
                            }
                        </section>
                    }
                }
            </div>
        </div>
        <div class="split-gutter" title="拖拉調整寬度，連點還原各半"></div>
        <div class="pane">
            <div class="tabs">
                <div class="tab @(S.RightTab == "log" ? "active" : null)" @onclick="@(() => S.SetRightTab("log"))">服務 Log</div>
                <div class="tab @(S.RightTab == "build" ? "active" : null)" @onclick="@(() => S.SetRightTab("build"))">建置輸出</div>
                <div class="tab @(S.RightTab == "audit" ? "active" : null)" @onclick="@(() => S.SetRightTab("audit"))">
                    MCP 審計
                    @if (S.AuditFailCount > 0)
                    {
                        <span class="badge badge-failed">@S.AuditFailCount</span>
                    }
                    else if (S.AuditTotal > 0)
                    {
                        <span class="badge">@S.AuditTotal</span>
                    }
                </div>
                <div class="tab @(S.RightTab == "ask" ? "active" : null)" @onclick="@(() => S.SetRightTab("ask"))">
                    專案問答
                    @if (S.AskBusy)
                    {
                        <span class="badge">…</span>
                    }
                    else if (S.AskMessages.Count > 0)
                    {
                        <span class="badge">@S.AskMessages.Count</span>
                    }
                </div>
                <div class="tab @(S.RightTab == "docs" ? "active" : null)" @onclick="@(() => S.SetRightTab("docs"))">
                    文件
                    @if (S.DocsDirty)
                    {
                        <span class="badge">未存</span>
                    }
                </div>
            </div>
            @if (S.RightTab == "log")
            {
                <div class="log-tools">
                    <strong>@S.LogTitle</strong>
                    <input class="log-search" placeholder="搜尋 Log…" value="@S.LogFilter" @oninput="OnLogFilter" />
                    <label class="check"><input type="checkbox" checked="@S.FollowLog" @onchange="e => S.FollowLog = (bool)(e.Value ?? false)" /> 跟隨最新</label>
                    <button class="btn-primary" disabled="@(!S.RuntimeHelpEnabled)" @onclick="S.OpenRuntimeHelp">執行求救</button>
                    <button class="btn-sec" @onclick="S.ReloadLog">重新載入</button>
                    <button class="btn-sec" @onclick="S.ClearLogView">清空顯示</button>
                    <button class="btn-sec" @onclick="S.OpenLogDir">開啟資料夾</button>
                </div>
                <pre class="log" id="log-view">@S.VisibleLogText</pre>
            }
            else if (S.RightTab == "build")
            {
                <div class="log-tools">
                    <strong>建置輸出</strong>
                    @if (!string.IsNullOrEmpty(S.BuildProgressText))
                    {
                        <span class="build-progress">@S.BuildProgressText</span>
                    }
                    @if (S.JobBusy && !string.IsNullOrEmpty(S.BuildCurrentName))
                    {
                        <span class="hint">@S.BuildCurrentName</span>
                    }
                    <button class="btn-primary" disabled="@(!S.CompileHelpEnabled)" @onclick="S.OpenCompileHelp">編譯求救</button>
                </div>
                <pre class="log" id="build-view">@S.BuildText</pre>
            }
            else if (S.RightTab == "audit")
            {
                <div class="log-tools">
                    <strong>MCP 審計</strong>
                    <span class="hint">@(S.AuditTotal > 0 ? $"最近 {S.AuditEntries.Count}／共 {S.AuditTotal} 筆" : "尚無紀錄")</span>
                    <input class="log-search" placeholder="搜尋工具／參數…" title="依工具名稱、參數或拒絕原因過濾" value="@S.AuditFilter" @oninput="OnAuditFilter" />
                    <button class="btn-sec" disabled="@(!S.HasProject)" title="從 .ai_project/mcp-audit.jsonl 讀取最新紀錄" @onclick="S.RefreshAudit">重新載入</button>
                    <button class="btn-sec" disabled="@(!S.HasProject)" title="用系統預設程式開啟 mcp-audit.jsonl" @onclick="S.OpenAuditDir">開啟檔案</button>
                </div>
                <div class="audit-help">
                    <p>這裡是 <strong>Agent 操作本機堆疊的對帳單</strong>。每次透過 MCP 呼叫（編譯、啟停、讀 Log）無論成功或被政策拒絕，都會寫進來。服務 Log 看程式輸出；這頁看「Agent 呼叫了哪支工具」。</p>
                    @if (S.AuditTotal == 0)
                    {
                        <ol>
                            <li>設定 → MCP，把「本控制台」加入專案，並重新載入 Cursor。</li>
                            <li>請 Agent 呼叫 <code>stack_status</code>、<code>build</code>、<code>get_log</code> 等工具（或問「用 duty_summary 看現在能不能交班」）。</li>
                            <li>回到這頁按「重新載入」。有拒絕時，上方摘要「MCP 拒絕」會變黃，點一下也會打開這裡。</li>
                        </ol>
                        <button class="btn-link" type="button" @onclick="@(() => S.OpenPreferences("mcp"))">前往 MCP 設定</button>
                    }
                    else
                    {
                        <p class="hint">每一列是一次呼叫：時間、OK／拒、工具、耗時、參數或拒絕原因。搜尋可過濾；「開啟檔案」看完整 <code>.ai_project/mcp-audit.jsonl</code>。</p>
                    }
                    @if (!string.IsNullOrEmpty(S.AuditPolicyText))
                    {
                        <p class="hint">@S.AuditPolicyText</p>
                    }
                    <p class="hint">可寫／唯讀＝Agent 能否編譯與啟停。允許＝白名單（空白＝全部）。禁止＝一律擋下。需確認＝必須帶 <code>confirm=true</code>（預設 <code>stop_all</code>）。改權限請到設定 → 權限。</p>
                </div>
                <div class="audit-list">
                    @if (S.VisibleAuditEntries.Any())
                    {
                        <div class="audit-row audit-head" aria-hidden="true">
                            <span>時間</span>
                            <span>結果</span>
                            <span>工具</span>
                            <span>耗時</span>
                            <span>參數／拒絕原因</span>
                        </div>
                    }
                    @foreach (var e in S.VisibleAuditEntries)
                    {
                        <div class="audit-row @(e.Ok ? "ok" : "fail")" title="@(e.Error ?? e.ArgsText)">
                            <span class="audit-when">@e.WhenText</span>
                            <span class="@(e.Ok ? "status-on" : "status-off")">@(e.Ok ? "OK" : "拒")</span>
                            <span class="audit-tool">@e.Tool</span>
                            <span class="hint">@(e.Ms)ms</span>
                            <span class="audit-detail">
                                @if (!string.IsNullOrEmpty(e.Error))
                                {
                                    <span class="audit-err">@e.Error</span>
                                }
                                else if (!string.IsNullOrEmpty(e.ArgsText))
                                {
                                    <span class="audit-args">@e.ArgsText</span>
                                }
                            </span>
                        </div>
                    }
                    @if (!S.VisibleAuditEntries.Any())
                    {
                        <div class="audit-empty">
                            @if (!S.HasProject)
                            {
                                <p class="hint">請先選擇專案目錄。審計檔會寫在該專案的 <code>.ai_project/mcp-audit.jsonl</code>。</p>
                            }
                            else if (S.AuditTotal == 0)
                            {
                                <p class="hint">目前沒有紀錄。這不是故障：Agent 還沒呼叫堆疊工具，或控制台尚未加入 Cursor 的 MCP。</p>
                            }
                            else
                            {
                                <p class="hint">沒有符合「@S.AuditFilter」的紀錄。清掉搜尋即可看到最近呼叫。</p>
                            }
                        </div>
                    }
                </div>
            }
            else if (S.RightTab == "docs")
            {
                <div class="log-tools">
                    <strong>@(string.IsNullOrEmpty(S.SelectedDocPath) ? "文件" : S.SelectedDocPath)</strong>
                    @if (S.DocsDirty)
                    {
                        <span class="warn">未儲存</span>
                    }
                    <span class="grow"></span>
                    <label class="check" title="在右側顯示目前這頁的 Markdown，不是 DocFX 網站">
                        <input type="checkbox" checked="@S.DocsPreviewMode" @onchange="e => S.SetDocsPreviewMode((bool)(e.Value ?? false))" />
                        本頁預覽
                    </label>
                    <button class="btn-sec" disabled="@(!S.HasProject || string.IsNullOrEmpty(S.SelectedDocPath) || S.JobBusy)" @onclick="@(() => S.AiFillDocsAsync(true))">AI 補齊本頁</button>
                    <button class="btn-primary" disabled="@(!S.HasProject || string.IsNullOrEmpty(S.SelectedDocPath) || !S.DocsDirty)" @onclick="S.SaveSelectedDoc">儲存</button>
                    <button class="btn-sec"
                            disabled="@S.JobBusy"
                            title="@(S.DocsPreviewOpensCurrentPage ? "用瀏覽器開 DocFX 網站的目前這頁" : "用瀏覽器開 DocFX 網站首頁")"
                            @onclick="S.ServeDocsAsync">
                        @(S.DocsServing
                            ? (S.DocsPreviewOpensCurrentPage ? "開啟本頁網站" : "開啟網站首頁")
                            : (S.DocsPreviewOpensCurrentPage ? "網站預覽本頁" : "網站預覽"))
                    </button>
                </div>
                <p class="hint doc-preview-hint">
                    「本頁預覽」只轉目前編輯的 Markdown。「網站預覽」會啟動 DocFX 並開瀏覽器到目前這頁；設定檔則開首頁。
                </p>
                @if (!S.HasProject)
                {
                    <p class="hint pane-pad">請先選擇專案目錄。</p>
                }
                else if (string.IsNullOrEmpty(S.SelectedDocPath))
                {
                    <p class="hint pane-pad">從左側目錄選一份文件再編修，或按「建立體系／新增文件」。</p>
                }
                else if (S.DocsPreviewMode)
                {
                    <div class="doc-preview">@((MarkupString)S.DocsPreviewHtml)</div>
                }
                else
                {
                    <textarea class="doc-editor" value="@S.DocsDraft" @oninput="OnDocsDraft" spellcheck="false"
                              placeholder="Markdown…"></textarea>
                }
            }
            else
            {
                <div class="log-tools">
                    <strong>專案問答</strong>
                    <span class="hint">@(S.AskBusy ? S.AskStatus : (S.AskConfigured ? "本機堆疊事實 · 不鎖控制台" : "尚未設定模型"))</span>
                    <button class="btn-sec" disabled="@(!S.AskBusy)" @onclick="S.CancelAsk">取消</button>
                </div>
                <div class="ask-help">
                    @if (!S.HasProject)
                    {
                        <p class="hint">請先選擇專案目錄。這頁只回答目前倉的值班、服務、編譯與 MCP 審計，不會外開 Cursor。</p>
                    }
                    else if (!S.AskConfigured)
                    {
                        <p class="hint">請到設定填寫專案問答的 Base URL 與模型。預設可接本機 Ollama（<code>http://127.0.0.1:11434/v1</code>）。</p>
                        <button class="btn-link" type="button" @onclick="@(() => S.OpenPreferences("ask"))">前往問答設定</button>
                    }
                    else
                    {
                        <p>用本機堆疊事實回答專案問題。點建議題或自己打字；等回覆時仍可切頁、看 Log、按啟動。</p>
                    }
                </div>
                <div class="ask-chips" role="list">
                    @foreach (var q in S.AskSuggestions)
                    {
                        <button type="button" class="ask-chip @(q.Highlighted ? "is-suggest" : null)" role="listitem"
                                disabled="@(!S.CanAsk)" title="@q.Prompt"
                                @onclick="@(() => S.SendAskSuggestionAsync(q.Prompt))">
                            @if (q.Highlighted)
                            {
                                <span class="ask-chip-mark">建議</span>
                            }
                            @q.Title
                        </button>
                    }
                </div>
                <div class="ask-list" id="ask-view">
                    @if (!S.AskMessages.Any())
                    {
                        <div class="ask-empty">
                            <p class="hint">尚無對話。點上方建議題，或在下方輸入。</p>
                        </div>
                    }
                    @foreach (var m in S.AskMessages)
                    {
                        <div class="ask-msg ask-@m.Role">
                            @if (m.Role == "tool")
                            {
                                <span class="hint">已呼叫 @m.Text</span>
                            }
                            else if (m.Role == "user")
                            {
                                <strong>你</strong>
                                <p>@m.Text</p>
                            }
                            else if (m.Role == "error")
                            {
                                <strong>錯誤</strong>
                                <p>@m.Text</p>
                            }
                            else
                            {
                                <strong>控制台</strong>
                                <p>@m.Text</p>
                            }
                        </div>
                    }
                </div>
                <div class="ask-compose">
                    <textarea value="@S.AskDraft" @oninput="OnAskDraft" placeholder="問這個專案：離線、需重編、Log、MCP 拒絕…"
                              disabled="@(!S.HasProject || !S.AskConfigured || S.AskBusy)"></textarea>
                    <button class="btn-primary" type="button" disabled="@(!S.CanAsk || string.IsNullOrWhiteSpace(S.AskDraft))"
                            @onclick="@(() => S.SendAskAsync())">送出</button>
                </div>
            }
        </div>
    </div>
    <div class="foot">關閉控制台不會停止服務 · 狀態寫入選定專案的 .ai_project/</div>
</div>

@if (S.Dialog == "gh-login")
{
    <div class="overlay">
        <div class="dialog" @onclick:stopPropagation="true" role="dialog" aria-labelledby="gh-login-title" aria-modal="true">
            <h2 id="gh-login-title">需要登入 GitHub</h2>
            <p class="hint">@(string.IsNullOrEmpty(S.GithubAuthHint) ? "此專案由 GitHub 管理。請先登入，才能讀取指派給你的 Issue。" : S.GithubAuthHint)</p>
