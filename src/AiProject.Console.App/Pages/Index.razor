@if (S.Dialog == "branch")
{
    <div class="overlay" @onclick="S.CloseDialog">
        <div class="dialog" @onclick:stopPropagation="true" role="dialog" aria-labelledby="branch-title" aria-modal="true">
            <h2 id="branch-title">切換分支</h2>
            <p class="hint">目前：@(S.GitBrief?.Branch ?? "（未知）")。工作區必須乾淨才能切換；切換後會立刻從遠端同步。</p>
            @if (!string.IsNullOrEmpty(S.BranchDialogHint))
            {
                <p class="hint">@S.BranchDialogHint</p>
            }
            <div class="branch-list" role="listbox" aria-label="分支清單">
                @if (S.BranchList.Count == 0)
                {
                    <p class="hint">尚無分支可選。</p>
                }
                else
                {
                    @foreach (var b in S.BranchList)
                    {
                        <button type="button"
                                class="branch-row @(b.IsCurrent ? "is-current" : null)"
                                disabled="@(S.JobBusy || b.IsCurrent || S.HasUncommitted)"
                                role="option"
                                aria-selected="@b.IsCurrent"
                                @onclick="@(() => S.SwitchToBranchAsync(b))">
                            <span class="branch-row-name">@b.Name</span>
                            <span class="hint">@b.Meta()</span>
                            @if (b.IsCurrent)
                            {
                                <span class="branch-now">目前</span>
                            }
                        </button>
                    }
                }
            </div>
            <div class="field">
                <span>新分支</span>
                <div class="field-inline">
                    <input @bind="S.NewBranchName" placeholder="例如 feat/login" disabled="@S.JobBusy" />
                    <button class="btn-sec" disabled="@S.JobBusy" @onclick="S.CreateBranchAsync">建立並切換</button>
                </div>
            </div>
            <div class="dialog-actions">
                <button class="btn-sec" @onclick="S.CloseDialog">關閉</button>
            </div>
        </div>
    </div>
}

@if (S.Dialog == "ci")
{
    <div class="overlay" @onclick="S.CloseDialog">
        <div class="dialog" @onclick:stopPropagation="true" role="dialog" aria-labelledby="ci-title" aria-modal="true">
            <h2 id="ci-title">Actions 狀態</h2>
            <p class="hint">遠端已經跑完。控制台不能修 CI；下一步：點一列或「開啟最新」到 GitHub 看 log。</p>
            @if (S.CanScaffoldCi)
            {
                <p class="hint">這個倉庫還沒有建置／測試 workflow。可寫入骨架，審查後再提交。</p>
            }
            @if (!string.IsNullOrEmpty(S.Actions?.Error))
            {
                <p class="hint warn">@S.Actions!.Error</p>
            }
            else if (S.Actions is null || S.Actions.Runs.Count == 0)
            {
                <p class="hint">@(S.Actions?.FormatReport() ?? "尚未讀到 Actions。")</p>
            }
            else
            {
                <div class="ci-list" role="list">
                    @foreach (var run in S.Actions.Runs)
                    {
                        <button type="button" class="ci-row" role="listitem" title="在瀏覽器開啟" @onclick="@(() => S.OpenCiRun(run.Url))">
                            <span class="ci-row-name">@run.Line()</span>
                            <span class="ci-row-meta">@(string.IsNullOrEmpty(run.Event) ? "GitHub" : run.Event)</span>
                        </button>
                    }
                </div>
            }
            <div class="dialog-actions">
                <button class="btn-sec" @onclick="S.CloseDialog">關閉</button>
                @if (S.CanScaffoldCi)
                {
                    <button class="btn-sec" disabled="@S.JobBusy" @onclick="@(() => S.ScaffoldCiWorkflowAsync())">補齊 CI workflow</button>
                }
                <button class="btn-primary" disabled="@(S.Actions?.Latest is null)" @onclick="S.OpenLatestCiRun">開啟最新</button>
            </div>
        </div>
    </div>
}

@if (S.Dialog == "pr")
{
    <div class="overlay" @onclick="S.CloseDialog">
        <div class="dialog" @onclick:stopPropagation="true" role="dialog" aria-labelledby="pr-title" aria-modal="true">
            <h2 id="pr-title">PR 檢查</h2>
            <p class="hint">控制台只看檢查過了沒有。留言、指定審查人與合併請到 GitHub。</p>
            @if (S.PullRequest is { HasPr: true } pr)
            {
                <p><strong>@pr.Title</strong></p>
                <p class="hint">@(string.IsNullOrEmpty(pr.Head) ? "" : pr.Head)@(string.IsNullOrEmpty(pr.Base) ? "" : " → " + pr.Base)@(pr.IsDraft ? " · 草稿" : "")</p>
                <p class="hint">@pr.Hint()</p>
                @if (pr.Checks.Count > 0)
                {
                    <div class="ci-list" role="list">
                        @foreach (var check in pr.Checks)
                        {
                            <button type="button" class="ci-row" role="listitem" title="在瀏覽器開啟" @onclick="@(() => S.OpenPrCheck(check.Url))">
                                <span class="ci-row-name">@check.Line()</span>
                                <span class="ci-row-meta">@(check.IsFailure ? "失敗" : check.IsPending ? "進行中" : "通過")</span>
                            </button>
                        }
                    </div>
                }
            }
            else
            {
                <p class="hint">@(S.PullRequest?.Hint() ?? "尚未讀到 PR。")</p>
            }
            <div class="dialog-actions">
                <button class="btn-sec" @onclick="S.CloseDialog">關閉</button>
                @if (S.CanScaffoldCi)
                {
                    <button class="btn-sec" disabled="@S.JobBusy" @onclick="@(() => S.ScaffoldCiWorkflowAsync())">補齊 CI workflow</button>
                }
                <button class="btn-primary" disabled="@(S.PullRequest is not { HasPr: true })" @onclick="S.OpenPullRequest">在 GitHub 開啟</button>
            </div>
        </div>
    </div>
}

