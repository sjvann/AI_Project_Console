@if (S.Dialog == "prefs")
{
    <div class="overlay" @onclick="S.CloseDialog">
        <div class="dialog dialog-lg" @onclick:stopPropagation="true">
            <h2>偏好設定</h2>
            <p class="hint">控制台擁有何時求救與帶什麼上下文；後端只負責在哪裡跑 Agent。</p>
            <div class="field">
                <span>Agent 後端</span>
                <select value="@S.AgentProvider" @onchange="OnAgentProvider">
                    @foreach (var b in S.AgentBackends)
                    {
                        <option value="@b.Id">@b.DisplayName</option>
                    }
                </select>
            </div>
            <p class="hint @(S.AgentAvailable ? "status-on" : "status-off")">@S.AgentDetectSummary</p>
            <div class="field"><span>CLI 路徑覆寫</span><input value="@S.AgentCliPath" @oninput="OnAgentCli" placeholder="空白＝自動偵測" /></div>
            @if (S.AgentProvider == "custom")
            {
                <div class="field"><span>自訂命令</span><input value="@S.CustomAgentCommand" @oninput="OnCustomCmd" placeholder="例如 aider 或 my-agent" /></div>
                <div class="field"><span>參數範本</span><input value="@S.CustomAgentArgs" @oninput="OnCustomArgs" placeholder="{root} {promptFile}" /></div>
                <p class="hint">可用變數：{root}、{promptFile}、{prompt}</p>
            }
            <label class="check">
                <input type="checkbox" checked="@S.RestoreLastProject" @onchange="e => S.SetRestoreLastProject((bool)(e.Value ?? false))" />
                啟動時還原上次專案
            </label>
            <label class="check">
                <input type="checkbox" checked="@S.OpenWithCursor" @onchange="e => S.SetOpenWithCursor((bool)(e.Value ?? false))" />
                載入專案時開啟 @S.AgentDisplayName
            </label>
            <div class="field">
                <span>外觀</span>
                <select value="@S.Theme" @onchange="OnTheme">
                    <option value="light">淺色</option>
                    <option value="dark">深色</option>
                </select>
            </div>
            <h3 class="prefs-sub">Agentic／MCP</h3>
            <p class="hint">讓 Cursor／Claude Code 呼叫控制台：看堆疊、編譯過期、啟停服務、讀 Log。開發管理者可用同一組工具值班。</p>
            <p class="hint">建議並排：GitHub MCP（PR／Issue）、Context7（套件文件）。本伺服器只負責本機堆疊真相。</p>
            <label class="check">
                <input type="checkbox" checked="@S.McpReadOnly" @onchange="e => S.McpReadOnly = (bool)(e.Value ?? false)" />
                MCP 唯讀（只能看狀態／Log，不能編譯或啟停）
            </label>
            <div class="field"><span>允許工具</span><input value="@S.McpAllow" @oninput="OnMcpAllow" placeholder="空白＝全部；逗號分隔" /></div>
            <div class="field"><span>禁止工具</span><input value="@S.McpDeny" @oninput="OnMcpDeny" placeholder="例如 stop_all" /></div>
            <div class="field"><span>需確認</span><input value="@S.McpConfirm" @oninput="OnMcpConfirm" placeholder="預設 stop_all" /></div>
            <p class="hint">專案 <code>.ai_project/mcp-policy.json</code> 會覆蓋以上項目。stop_all 必須帶 confirm=true。每次呼叫寫入 mcp-audit.jsonl。</p>
            <div class="row">
                <button class="btn-sec" @onclick="S.CopyMcpConfigAsync">複製 MCP 設定</button>
                <button class="btn-sec" disabled="@(!S.HasProject)" @onclick="S.WriteMcpConfigToProject">寫入目前專案 .cursor/mcp.json</button>
                <button class="btn-sec" disabled="@(!S.HasProject)" @onclick="S.WriteMcpPolicyToProject">寫入政策範本</button>
            </div>
            <div class="dialog-actions">
                <button class="btn-sec" @onclick="S.CloseDialog">取消</button>
                <button class="btn-primary" @onclick="S.SavePreferences">儲存</button>
            </div>
        </div>
    </div>
}

