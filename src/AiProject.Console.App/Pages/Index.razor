@if (S.Dialog == "prefs")
{
    <div class="overlay" @onclick="S.CloseDialog">
        <div class="dialog dialog-lg prefs-dialog" @onclick:stopPropagation="true" role="dialog" aria-labelledby="prefs-title">
            <div class="prefs-head">
                <h2 id="prefs-title">偏好設定</h2>
            </div>
            <div class="prefs-tabs" role="tablist" aria-label="設定分類" @onkeydown="OnPrefsTabKey">
                <button type="button" role="tab" class="prefs-tab @(S.PrefsTab == "general" ? "active" : null)"
                        id="prefs-tab-general" aria-selected="@(S.PrefsTab == "general" ? "true" : "false")"
                        aria-controls="prefs-panel-general" @onclick="@(() => S.SetPrefsTab("general"))">一般</button>
                <button type="button" role="tab" class="prefs-tab @(S.PrefsTab == "agent" ? "active" : null)"
                        id="prefs-tab-agent" aria-selected="@(S.PrefsTab == "agent" ? "true" : "false")"
                        aria-controls="prefs-panel-agent" @onclick="@(() => S.SetPrefsTab("agent"))">Agent</button>
                <button type="button" role="tab" class="prefs-tab @(S.PrefsTab == "mcp" ? "active" : null)"
                        id="prefs-tab-mcp" aria-selected="@(S.PrefsTab == "mcp" ? "true" : "false")"
                        aria-controls="prefs-panel-mcp" @onclick="@(() => S.SetPrefsTab("mcp"))">MCP</button>
                <button type="button" role="tab" class="prefs-tab @(S.PrefsTab == "tools" ? "active" : null)"
                        id="prefs-tab-tools"
                        aria-selected="@(S.PrefsTab == "tools" ? "true" : "false")"
                        aria-controls="prefs-panel-tools" @onclick="@(() => S.SetPrefsTab("tools"))">工具權限</button>
                <button type="button" role="tab" class="prefs-tab @(S.PrefsTab == "ask" ? "active" : null)"
                        id="prefs-tab-ask"
                        aria-selected="@(S.PrefsTab == "ask" ? "true" : "false")"
                        aria-controls="prefs-panel-ask" @onclick="@(() => S.SetPrefsTab("ask"))">專案問答</button>
            </div>
            <div class="prefs-body">
                @if (S.PrefsTab == "general")
                {
                    <div id="prefs-panel-general" role="tabpanel" aria-labelledby="prefs-tab-general">
                        <p class="hint">控制台外觀與啟動時要不要還原專案。</p>
                        <div class="field">
                            <span>外觀</span>
                            <select value="@S.Theme" @onchange="OnTheme">
                                <option value="light">淺色</option>
                                <option value="dark">深色</option>
                            </select>
                        </div>
                        <label class="check">
                            <input type="checkbox" checked="@S.RestoreLastProject" @onchange="e => S.SetRestoreLastProject((bool)(e.Value ?? false))" />
                            啟動時還原上次專案
                        </label>
                        <label class="check">
                            <input type="checkbox" checked="@S.OpenWithCursor" @onchange="e => S.SetOpenWithCursor((bool)(e.Value ?? false))" />
                            載入專案時開啟 @S.AgentDisplayName
                        </label>
                    </div>
                }
                else if (S.PrefsTab == "agent")
                {
                    <div id="prefs-panel-agent" role="tabpanel" aria-labelledby="prefs-tab-agent">
                        <p class="hint">控制台擁有何時求救與帶什麼上下文；後端只負責在哪裡跑 Agent。</p>
                        <div class="field">
                            <span>Agent 後端</span>
                            <select value="@S.AgentProvider" @onchange="OnAgentProvider">
                                @foreach (var b in S.AgentBackends)
                                {
                                    <option value="@b.Id">@b.DisplayName</option>
                                }
                            </select>
                        </div>
                        <p class="hint @(S.AgentAvailable ? "status-on" : "status-off")">@S.AgentDetectSummary</p>
                        <div class="field"><span>CLI 路徑覆寫</span><input value="@S.AgentCliPath" @oninput="OnAgentCli" placeholder="空白＝自動偵測" /></div>
                        @if (S.AgentProvider == "custom")
                        {
                            <div class="field"><span>自訂命令</span><input value="@S.CustomAgentCommand" @oninput="OnCustomCmd" placeholder="例如 aider 或 my-agent" /></div>
                            <div class="field"><span>參數範本</span><input value="@S.CustomAgentArgs" @oninput="OnCustomArgs" placeholder="{root} {promptFile}" /></div>
                            <p class="hint">可用變數：{root}、{promptFile}、{prompt}</p>
                        }
                    </div>
                }
                else
                {
                    <div id="prefs-panel-@S.PrefsTab" role="tabpanel" aria-labelledby="prefs-tab-@S.PrefsTab">
                        <McpPrefsSection S="S" Section="@S.PrefsTab" />
                    </div>
                }
            </div>
            <div class="dialog-actions">
                <button class="btn-sec" @onclick="S.CloseDialog">取消</button>
                <button class="btn-primary" @onclick="S.SavePreferences">儲存</button>
            </div>
        </div>
    </div>
}

