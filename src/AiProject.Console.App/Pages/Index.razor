@page "/"
@inject ConsoleSession S
@inject IJSRuntime Js
@implements IDisposable

<div class="shell">
    <div class="head">
        <img class="brand-mark" src="img/logo.svg" width="32" height="32" alt="" />
        <h1>AI_Project 控制台</h1>
        <span class="hint">通用本機堆疊 · GitHub／部署 · v@(AppInfo.Version)</span>
        <div class="hours-panes workbench-switch" role="tablist" aria-label="工作台">
            <button type="button" class="hours-pane @(S.Workbench == "dev" ? "active" : null)" @onclick="@(() => S.SetWorkbench("dev"))">開發</button>
            <button type="button" class="hours-pane @(S.Workbench == "req" ? "active" : null)" @onclick="@(() => S.SetWorkbench("req"))">需求</button>
        </div>
        <span class="grow"></span>
        <button type="button" class="hours-chip is-@S.WorkHoursTone" title="從開啟專案起算的工時，點擊看週／月／季／年與報帳單" @onclick="@(() => S.OpenWorkHours())">
            <span class="hours-chip-k">本次</span>
            <span class="hours-chip-v">@S.SessionWorkText</span>
            <span class="hours-chip-div" aria-hidden="true"></span>
            <span class="hours-chip-k">今日</span>
            <span class="hours-chip-v">@S.TodayWorkText</span>
        </button>
        <button class="btn-sec" @onclick="@(() => S.OpenPreferences())">設定</button>
        <button class="btn-sec" disabled="@S.JobBusy" @onclick="S.CheckUpdateAsync">檢查更新</button>
        <button type="button" class="gh-id @(S.GithubLoggedIn ? null : "is-muted")" title="GitHub 操作台（Ctrl+G）" @onclick="S.ToggleGithubHub">
            @if (S.GithubLoggedIn)
            {
                <span class="gh-id-dot" aria-hidden="true"></span>
                <span>@S.GithubAccountText</span>
            }
            else
            {
                <span>GitHub</span>
            }
        </button>
        <button class="btn-danger" @onclick="S.ExitAsync">離開</button>
    </div>

    @if (S.UpdateAvailable is not null)
    {
        <div class="update-banner">
            <span>發現新版本 @S.UpdateAvailable.Tag（目前 v@(AppInfo.Version)）</span>
            <span class="grow"></span>
            <button class="btn-primary" disabled="@S.JobBusy" @onclick="S.ApplyUpdateAsync">立即更新</button>
            <button class="btn-sec" @onclick="S.OpenUpdatePage">查看說明</button>
            <button class="btn-sec" @onclick="S.DismissUpdate">稍後再說</button>
        </div>
    }

    <div class="card">
        <div class="row">
            <strong>@(S.Catalog?.Name ?? "尚未選擇專案")</strong>
            @if (S.HasProject && S.GitBrief is not null)
            {
                <button type="button"
                        class="branch-chip @(S.GitBrief.IsClearToLeave ? "is-ok" : "is-warn")"
                        disabled="@S.JobBusy"
                        title="目前分支，點擊切換"
                        @onclick="S.OpenBranchDialogAsync">
                    <span class="branch-chip-label">分支</span>
                    <span class="branch-chip-name">@S.GitBrief.Branch</span>
                    <span class="branch-chip-caret" aria-hidden="true"></span>
                </button>
            }
            <span class="hint grow">@(S.Catalog?.Root ?? "啟動後請選擇專案目錄、從歷史載入，或從 GitHub 開啟。")</span>
            <select class="history" @key="HistorySelectValue" value="@HistorySelectValue" @onchange="OnRecent">
                <option value="">歷史專案</option>
                @foreach (var p in S.RecentProjects)
                {
                    <option value="@p">@System.IO.Path.GetFileName(p) — @p</option>
                }
            </select>
            <button class="btn-sec" @onclick="S.PickProjectAsync">選擇專案目錄…</button>
            <button class="btn-sec" @onclick="S.OpenCloneDialog">從 GitHub 開啟…</button>
            <button class="btn-sec" disabled="@(!S.HasProject || S.JobBusy)" title="重新掃描專案目錄，找出新增或移除的專案與服務" @onclick="S.RefreshWorkspaceAsync">重新掃描</button>
            <button class="btn-sec" disabled="@(!S.HasProject || S.JobBusy)" @onclick="S.CloseProjectAsync">關閉專案</button>
            <label class="check">
                <input type="checkbox" checked="@S.RestoreLastProject" @onchange="e => S.SetRestoreLastProject((bool)(e.Value ?? false))" />
                啟動時還原上次專案
            </label>
            <label class="check">
                <input type="checkbox" checked="@S.OpenWithCursor" @onchange="e => S.SetOpenWithCursor((bool)(e.Value ?? false))" />
                同時開啟 @S.AgentDisplayName
            </label>
        </div>
        <GitPulse />
    </div>

    @if (!S.IsReqWorkbench)
    {
    <div class="card">
        <div class="row">
            <button class="btn-primary" disabled="@S.JobBusy" @onclick="S.StartAllAsync">啟動</button>
            <button class="btn-danger" disabled="@S.JobBusy" @onclick="S.StopAllAsync">停止全部</button>
            <span class="sep"></span>
            <div class="menu @(openMenu == "urls" ? "open" : null)">
                <button class="btn-sec" @onclick="@(() => Toggle("urls"))">開啟前端</button>
                <div class="menu-list">
                    <button @onclick="@(() => { S.OpenUrls(true); openMenu = null; })">開啟前端</button>
                    <button @onclick="@(() => { S.OpenUrls(false); openMenu = null; })">開啟全部 URL</button>
                </div>
            </div>
            <button class="btn-primary" @onclick="S.OpenUatDialog">UAT 求救</button>
            <span class="sep"></span>
            <ActionMenu Title="建置" Actions="S.BuildActions" Session="S" @bind-Open="openMenu" Key="build" />
            <span class="sep"></span>
            <ActionMenu Title="部署" Actions="S.DeployActions" Session="S" @bind-Open="openMenu" Key="deploy" />
            <ActionMenu Title="文件" Actions="S.DocsActions" Session="S" @bind-Open="openMenu" Key="docs" />
            <button type="button"
                    class="git-pulse-mark row-end @(S.GithubHubOpen ? "is-open" : null) @(S.GitPulseBlocked ? "is-warn" : null)"
                    title="開啟 GitHub 操作台（Ctrl+G）"
                    aria-haspopup="true"
                    aria-expanded="@S.GithubHubOpen"
                    @onclick="S.ToggleGithubHub">
                GitHub 操作台
            </button>
            <button type="button"
                    class="btn-sec @(S.AskPanelOpen ? "is-open" : null)"
                    title="用本機堆疊事實回答專案問題"
                    aria-haspopup="dialog"
                    aria-expanded="@S.AskPanelOpen"
                    @onclick="S.ToggleAskPanel">
                專案問答
                @if (S.AskBusy)
                {
                    <span class="badge">…</span>
                }
            </button>
            <button class="btn-sec" @onclick="S.Doctor">環境體檢</button>
        </div>
    </div>
    }

    @if (S.GithubHubOpen)
    {
        <GithubHub />
    }

    @if (S.AskPanelOpen)
    {
        <AskPanel />
    }

    @if (S.AuditPanelOpen)
    {
        <AuditPanel />
    }

    @if (S.IsReqWorkbench)
    {
        <IntakeWorkbench />
    }
    else
    {

    <div class="summary">
        <span>@S.ReadyText</span>
        @if (S.HasProject)
        {
            <button type="button" class="duty-chip @(S.StaleProjectCount > 0 ? "is-warn" : "is-ok")" @onclick="S.ShowStaleProjects">
                需重編 @S.StaleProjectCount
            </button>
            <button type="button" class="duty-chip @(S.AuditIncidentCount > 0 ? "is-warn" : "is-ok")" title="對帳單。政策擋下或未知工具不是故障；點一下看原因。" @onclick="S.OpenAuditPanel">
                MCP 拒絕 @S.AuditFailCount
            </button>
            @if (S.GithubManaged)
            {
                <button type="button" class="duty-chip @(S.AssignedIssues.Count > 0 ? "is-ok" : "is-wait")" @onclick="S.ShowTasks">
                    我的任務 @S.AssignedIssues.Count
                </button>
            }
            <button type="button" class="duty-chip @(S.DocsChipWarn ? "is-warn" : "is-ok")" title="專案文件（docs/）" @onclick="S.ShowDocs">
                @(S.Docs?.ChipText() ?? "文件 無文件")
            </button>
            @if (!string.IsNullOrEmpty(S.DutyAttention))
            {
                <span class="duty-attn @(S.DutyOk ? "status-on" : "warn")">@S.DutyAttention</span>
            }
        }
        <span class="job">@S.JobText</span>
        @if (!string.IsNullOrEmpty(S.WarnText))
        {
            <span class="warn">@S.WarnText</span>
        }
    </div>

    <div class="workspace">
        <div class="tabs workspace-tabs" role="tablist" aria-label="服務、專案與文件">
            <div class="tab @(S.LeftTab == "svc" ? "active" : null)" role="tab" tabindex="0" aria-selected="@(S.LeftTab == "svc")" title="連點：全部展開／收合" @onclick="@(() => S.SetWorkspaceTab("svc"))" @ondblclick="S.ToggleAllServiceGroups" @onkeydown="@(e => OnWorkspaceTabKey(e, "svc"))">
                服務 <span class="badge">@S.ReadyCount/@S.ServiceCount</span>
            </div>
            <div class="tab @(S.LeftTab == "prj" ? "active" : null)" role="tab" tabindex="0" aria-selected="@(S.LeftTab == "prj")" title="連點：全部展開／收合" @onclick="@(() => S.SetWorkspaceTab("prj"))" @ondblclick="S.ToggleAllProjectGroups" @onkeydown="@(e => OnWorkspaceTabKey(e, "prj"))">
                專案 <span class="badge">@(S.StaleProjectCount > 0 ? $"{S.StaleProjectCount} 需重編" : $"{S.Projects.Count}")</span>
            </div>
            <div class="tab @(S.LeftTab == "docs" ? "active" : null)" role="tab" tabindex="0" aria-selected="@(S.LeftTab == "docs")" title="專案 docs/" @onclick="S.ShowDocs" @onkeydown="@(e => OnWorkspaceTabKey(e, "docs"))">
                文件
                @if (S.Docs is not null)
                {
                    <span class="badge">@S.Docs.FileCount</span>
                }
            </div>
        </div>
        <div class="split" id="split-view">
        <div class="pane">
            <div class="pane-body">
                @if (S.LeftTab == "svc")
                {
                    @if (S.Catalog is null || S.Catalog.Services.Count == 0)
                    {
                        <p class="hint">沒有服務或 UI。可放置 ai-project.json；Web 專案請確認 launchSettings 有 applicationUrl。Blazor／桌面 UI 即使沒有網址也會列入。</p>
                    }
                    else
                    {
                        @foreach (var node in S.VisibleServiceGroupNodes())
                        {
                            var svcCollapsed = S.IsServiceGroupCollapsed(node.Key);
                            var groupActs = S.ActionsFor(node);
                            <div class="group-row" style="padding-left: @(4 + node.Depth * 14)px">
                                <button type="button" class="group-label @(svcCollapsed ? "collapsed" : null)" title="展開／收合" aria-expanded="@(!svcCollapsed)" @onclick="@(() => S.ToggleServiceGroup(node.Key))">
                                    <span class="group-chevron" aria-hidden="true"></span>
                                    <span>@node.Name</span>
                                    <span class="group-count">@node.ServiceCount</span>
                                </button>
                                <span class="group-actions">
                                    @if (groupActs.Open)
                                    {
                                        <button type="button" class="btn-link" disabled="@S.JobBusy" title="開啟此群組全部網址" @onclick:stopPropagation="true" @onclick="@(() => S.OpenGroupUrls(node.Key))">開啟</button>
                                    }
                                    @if (groupActs.Start)
                                    {
                                        <button type="button" class="btn-link" disabled="@S.JobBusy" title="啟動此群組離線服務" @onclick:stopPropagation="true" @onclick="@(() => S.StartGroupAsync(node.Key))">啟動</button>
                                    }
                                    @if (groupActs.Restart)
                                    {
                                        <button type="button" class="btn-link" disabled="@S.JobBusy" title="重啟此群組線上服務" @onclick:stopPropagation="true" @onclick="@(() => S.RestartGroupAsync(node.Key))">重啟</button>
                                    }
                                    @if (groupActs.Stop)
                                    {
                                        <button type="button" class="btn-link" disabled="@S.JobBusy" title="停止此群組線上服務" @onclick:stopPropagation="true" @onclick="@(() => S.StopGroupAsync(node.Key))">停止</button>
                                    }
                                </span>
                            </div>
                            @if (!svcCollapsed)
                            {
                            @foreach (var svc in node.Services)
                            {
                                var self = S.IsSelfService(svc);
                                var on = self || S.Health.GetValueOrDefault(svc.Id);
                                var acts = S.ActionsFor(svc);
                                var activity = S.ServiceActivityText(svc);
                                <div class="svc @(S.SelectedServiceId == svc.Id ? "sel" : null) @(activity is not null ? "is-busy" : null)" style="padding-left: @(8 + (node.Depth + 1) * 14)px" @onclick="@(() => S.SelectService(svc.Id))">
                                    <span class="@(on ? "status-on" : "status-off")">@(self ? "本機" : on ? "線上" : "離線")</span>
                                    <span class="svc-label">
                                        <span>@svc.Label</span>
                                        @if (activity is not null)
                                        {
                                            <span class="svc-busy" aria-live="polite">@activity</span>
                                        }
                                        @if (S.HasDepends(svc))
                                        {
                                            <span class="svc-deps" title="@S.DependsHint(svc)">依 @(string.Join("、", svc.Dependencies.Select(d => d.Id)))</span>
                                        }
                                    </span>
                                    <span class="hint">@(svc.Port?.ToString() ?? "-")</span>
                                    <span>
                                        @if (acts.Open)
                                        {
                                            <button type="button" class="btn-link" disabled="@S.JobBusy" @onclick:stopPropagation="true" @onclick="@(() => S.OpenServiceUrl(svc))">開啟</button>
                                        }
                                        @if (acts.SelfHint)
                                        {
                                            <span class="hint" title="這是目前這個控制台，再啟動會再開一扇視窗">目前這個視窗</span>
                                        }
                                        else if (acts.HostedHint)
                                        {
                                            <span class="hint">隨 @svc.HostedBy</span>
                                        }
                                        else
                                        {
                                            @if (acts.Start)
                                            {
                                                <button type="button" class="btn-link" disabled="@S.JobBusy" title="@(S.HasDepends(svc) ? "啟動（含相依）。Alt：略過可選相依；Shift：只起自己" : "啟動")" @onclick:stopPropagation="true" @onclick="@(e => S.StartOneAsync(svc, skipOptional: e.AltKey, skipDepends: e.ShiftKey))">啟動</button>
                                            }
                                            @if (acts.Restart)
                                            {
                                                <button type="button" class="btn-link" disabled="@S.JobBusy" @onclick:stopPropagation="true" @onclick="@(() => S.RestartOneAsync(svc))">重啟</button>
                                            }
                                            @if (acts.Stop)
                                            {
                                                <button type="button" class="btn-link" disabled="@S.JobBusy" @onclick:stopPropagation="true" @onclick="@(() => S.StopOneAsync(svc))">停止</button>
                                            }
                                        }
                                        @if (S.StartErrorFor(svc) is { } startErr)
                                        {
                                            <span class="svc-err" title="@startErr">失敗</span>
                                        }
                                    </span>
                                </div>
                            }
                            }
                        }
                    }
                }
                else if (S.LeftTab == "prj")
                {
                    <div class="row">
                        <label class="check"><input type="checkbox" checked="@S.StaleOnly" @onchange="e => { S.StaleOnly = (bool)(e.Value ?? false); }" /> 只看需重編</label>
                        <button class="btn-sec" disabled="@(!S.HasProject || S.JobBusy)" title="重新掃描專案目錄並更新編譯狀態" @onclick="S.RefreshWorkspaceAsync">刷新</button>
                    </div>
                    <div class="prj-list">
                    @foreach (var g in S.ProjectGroups)
                    {
                        var prjCollapsed = S.IsProjectGroupCollapsed(g.Key);
                        <button type="button" class="group-label @(prjCollapsed ? "collapsed" : null)" title="展開／收合" aria-expanded="@(!prjCollapsed)" @onclick="@(() => S.ToggleProjectGroup(g.Key))">
                            <span class="group-chevron" aria-hidden="true"></span>
                            <span>@g.Key</span>
                            <span class="group-count">@g.Count()</span>
                        </button>
                        @if (!prjCollapsed)
                        {
                        @foreach (var p in g)
                        {
                            var kind = BuildFreshness.RowKind(p);
                            var badge = BuildFreshness.BadgeText(p);
                            var ago = BuildFreshness.FormatAgo(p.LastBuildUtc);
                            <div class="prj prj-@kind" title="@p.Reason">
                                <span class="prj-name">@p.Name</span>
                                <span class="meta">@ProjectMeta(p, ago)</span>
                                <span class="badge-stale badge-@kind">@badge</span>
                                <button class="btn-link" @onclick="@(() => S.BuildOneAsync(p.Path))">編譯</button>
                            </div>
                        }
                        }
                    }
                    </div>
                    @if (!S.VisibleProjects.Any())
                    {
                        <p class="hint">@(S.Catalog is null ? "請先選擇專案目錄。" : "沒有專案。")</p>
                    }
                }
                else if (S.LeftTab == "docs")
                {
                    <div class="row task-toolbar">
                        <span class="hint grow">@(S.Docs?.Label() ?? "尚未掃描")</span>
                        <button class="btn-sec" disabled="@(!S.HasProject || S.JobBusy)" @onclick="S.ScaffoldDocsAsync">建立體系</button>
                        <button class="btn-sec" disabled="@(!S.HasProject)" @onclick="@(() => S.OpenNewDocDialog())">新增文件</button>
                        <button class="btn-sec" disabled="@(!S.HasProject || string.IsNullOrEmpty(S.SelectedDocPath))" @onclick="@(() => S.DeleteDoc(S.SelectedDocPath!))">刪除</button>
                        <button class="btn-sec" disabled="@(!S.HasProject)" @onclick="S.RefreshDocsFromUi">刷新</button>
                    </div>
                    @if (!string.IsNullOrEmpty(S.DocsHint))
                    {
                        <p class="hint">@S.DocsHint</p>
                    }
                    @if (S.Catalog is null)
                    {
                        <p class="hint">請先選擇專案目錄。文件規定都放在 docs/。</p>
                    }
                    else if (S.Docs is null || S.Docs.Files.Count == 0)
                    {
                        <p class="hint">還沒有 docs/。按「建立體系」產生標準 Markdown 骨架與 DocFX 設定。</p>
                    }
                    else
                    {
                        <div class="doc-tree" role="tree" aria-label="文件目錄">
                            <div class="doc-tree-root">docs/</div>
                            @foreach (var row in S.VisibleDocsTree)
                            {
                                var pad = 8 + row.Depth * 14;
                                if (row.IsFolder)
                                {
                                    var collapsed = S.IsDocFolderCollapsed(row.RelPath);
                                    <div class="doc-tree-line" style="padding-left: @(pad)px">
                                        <button type="button"
                                                class="doc-folder @(collapsed ? "collapsed" : null)"
                                                role="treeitem"
                                                aria-expanded="@(!collapsed)"
                                                title="展開／收合"
                                                @onclick="@(() => S.ToggleDocFolder(row.RelPath))">
                                            <span class="group-chevron" aria-hidden="true"></span>
                                            <span class="doc-folder-name">@row.Name/</span>
                                            <span class="group-count">@row.ChildCount</span>
                                        </button>
                                        <button type="button"
                                                class="btn-link doc-folder-add"
                                                title="在此目錄新增文件"
                                                @onclick="@(() => S.OpenNewDocDialog(row.RelPath))">新增</button>
                                    </div>
                                }
                                else if (row.File is { } f)
                                {
                                    <div class="doc-tree-line" style="padding-left: @(pad)px">
                                        <button type="button"
                                                class="doc-file @(f.RelPath == S.SelectedDocPath ? "sel" : null)"
                                                role="treeitem"
                                                aria-selected="@(f.RelPath == S.SelectedDocPath)"
                                                title="@f.RelPath"
                                                @onclick="@(() => S.SelectDocAsync(f.RelPath))">
                                            <span class="doc-file-name">@row.Name</span>
                                            <span class="hint">@f.Title</span>
                                            @if (f.IsStub)
                                            {
                                                <span class="doc-stub">待補</span>
                                            }
                                        </button>
                                        <button type="button"
                                                class="doc-file-del"
                                                title="刪除此文件"
                                                @onclick="@(() => S.DeleteDoc(f.RelPath))">刪除</button>
                                    </div>
                                }
                            }
                        </div>
                    }
                }
            </div>
        </div>
        <div class="split-gutter" title="拖拉調整寬度，連點還原各半"></div>
        <div class="pane">
            @if (S.LeftTab == "svc")
            {
                <div class="log-tools">
                    <strong>@S.LogTitle</strong>
                    <input class="log-search" placeholder="搜尋 Log…" value="@S.LogFilter" @oninput="OnLogFilter" />
                    <label class="check"><input type="checkbox" checked="@S.FollowLog" @onchange="e => S.FollowLog = (bool)(e.Value ?? false)" /> 跟隨最新</label>
                    <button class="btn-primary" disabled="@(!S.RuntimeHelpEnabled)" @onclick="S.OpenRuntimeHelp">執行求救</button>
                    <button class="btn-sec" @onclick="S.ReloadLog">重新載入</button>
                    <button class="btn-sec" @onclick="S.ClearLogView">清空顯示</button>
                    <button class="btn-sec" @onclick="S.OpenLogDir">開啟資料夾</button>
                </div>
                <pre class="log" id="log-view">@S.VisibleLogText</pre>
            }
            else if (S.LeftTab == "prj")
            {
                <div class="log-tools">
                    <strong>建置輸出</strong>
                    @if (!string.IsNullOrEmpty(S.BuildProgressText))
                    {
                        <span class="build-progress">@S.BuildProgressText</span>
                    }
                    @if (S.JobBusy && !string.IsNullOrEmpty(S.BuildCurrentName))
                    {
                        <span class="hint">@S.BuildCurrentName</span>
                    }
                    <button class="btn-primary" disabled="@(!S.CompileHelpEnabled)" @onclick="S.OpenCompileHelp">編譯求救</button>
                </div>
                <pre class="log" id="build-view">@S.BuildText</pre>
            }
            else
            {
                <div class="log-tools">
                    <strong>@(string.IsNullOrEmpty(S.SelectedDocPath) ? "文件" : S.SelectedDocPath)</strong>
                    @if (S.DocsDirty)
                    {
                        <span class="warn">未儲存</span>
                    }
                    <span class="grow"></span>
                    <label class="check" title="在右側顯示目前這頁的 Markdown，不是 DocFX 網站">
                        <input type="checkbox" checked="@S.DocsPreviewMode" @onchange="e => S.SetDocsPreviewMode((bool)(e.Value ?? false))" />
                        本頁預覽
                    </label>
                    <button class="btn-sec" disabled="@(!S.HasProject || string.IsNullOrEmpty(S.SelectedDocPath) || S.JobBusy)" @onclick="@(() => S.AiFillDocsAsync(true))">AI 補齊本頁</button>
                    <button class="btn-primary" disabled="@(!S.HasProject || string.IsNullOrEmpty(S.SelectedDocPath) || !S.DocsDirty)" @onclick="S.SaveSelectedDoc">儲存</button>
                    <button class="btn-sec" disabled="@(!S.HasProject || string.IsNullOrEmpty(S.SelectedDocPath))" @onclick="@(() => S.DeleteDoc(S.SelectedDocPath!))">刪除</button>
                    <button class="btn-sec"
                            disabled="@S.JobBusy"
                            title="@(S.DocsPreviewOpensCurrentPage ? "用瀏覽器開 DocFX 網站的目前這頁" : "用瀏覽器開 DocFX 網站首頁")"
                            @onclick="S.ServeDocsAsync">
                        @(S.DocsServing
                            ? (S.DocsPreviewOpensCurrentPage ? "開啟本頁網站" : "開啟網站首頁")
                            : (S.DocsPreviewOpensCurrentPage ? "網站預覽本頁" : "網站預覽"))
                    </button>
                </div>
                <p class="hint doc-preview-hint">
                    「本頁預覽」只轉目前編輯的 Markdown。「網站預覽」會啟動 DocFX 並開瀏覽器到目前這頁；設定檔則開首頁。
                </p>
                @if (!S.HasProject)
                {
                    <p class="hint pane-pad">請先選擇專案目錄。</p>
                }
                else if (string.IsNullOrEmpty(S.SelectedDocPath))
                {
                    <p class="hint pane-pad">從左側目錄選一份文件再編修，或按「建立體系／新增文件」。</p>
                }
                else if (S.DocsPreviewMode)
                {
                    <div class="doc-preview">@((MarkupString)S.DocsPreviewHtml)</div>
                }
                else
                {
                    <textarea class="doc-editor" value="@S.DocsDraft" @oninput="OnDocsDraft" spellcheck="false"
                              placeholder="Markdown…"></textarea>
                }
            }
        </div>
        </div>
    </div>
    }

    <div class="foot">關閉控制台不會停止服務 · 狀態寫入選定專案的 .ai_project/</div>
</div>

@if (S.Dialog == "gh-login")
