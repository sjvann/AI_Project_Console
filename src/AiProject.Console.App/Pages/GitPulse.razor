@inject ConsoleSession S

@if (S.ShowGitPulse)
{
    <div class="git-pulse @(S.GitPulseBlocked ? "is-blocked" : null)" role="region" aria-label="GitHub 狀態">
        <button type="button"
                class="git-pulse-mark @(S.GithubHubOpen ? "is-open" : null) @(S.GitPulseBlocked ? "is-warn" : null)"
                title="開啟 GitHub 操作台（Ctrl+G）"
                aria-haspopup="dialog"
                aria-expanded="@S.GithubHubOpen"
                @onclick="S.OpenGithubHub">
            GitHub 操作台
        </button>
        @if (S.GitBrief is { } brief)
        {
            <button type="button"
                    class="branch-chip @(brief.IsClearToLeave ? "is-ok" : "is-warn")"
                    disabled="@S.JobBusy"
                    title="目前分支，點擊切換"
                    @onclick="S.OpenBranchDialogAsync">
                <span class="branch-chip-label">分支</span>
                <span class="branch-chip-name">@brief.Branch</span>
                <span class="branch-chip-caret" aria-hidden="true"></span>
            </button>
            <span class="git-pulse-meta">@brief.PulseMeta()</span>
        }
        else
        {
            <span class="git-pulse-meta">尚未是 git 倉</span>
        }
        <span class="git-pulse-hint" title="@S.GithubNext.Hint">@S.GithubNext.Hint</span>
        <span class="grow"></span>
        @if (S.GithubNext.OpensHub)
        {
            <button type="button" class="btn-primary" @onclick="S.OpenGithubHub">@S.GithubNext.Label</button>
        }
        else
        {
            <button type="button" class="btn-primary" disabled="@S.JobBusy" @onclick="S.RunGithubNextAsync">@S.GithubNext.Label</button>
            <button type="button" class="btn-sec" @onclick="S.OpenGithubHub">全部動作</button>
        }
        @if (S.ShowCiChip)
        {
            <button type="button" class="duty-chip is-@S.CiChipTone" title="遠端已經跑完。控制台不能修 CI；點一下到 GitHub 看 log。" @onclick="S.OpenCiDialogAsync">
                @S.CiChipText
            </button>
        }
        @if (S.ShowPrChip)
        {
            <button type="button" class="duty-chip is-@S.PrChipTone" title="目前分支的 PR 檢查是否通過，點一下看摘要" @onclick="S.OpenPrDialogAsync">
                @S.PrChipText
            </button>
        }
    </div>
}
