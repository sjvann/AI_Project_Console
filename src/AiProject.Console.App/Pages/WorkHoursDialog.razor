@using AiProject.Console.Core.WorkHours

<div class="overlay" @onclick="S.CloseDialog">
    <div class="dialog dialog-lg hours-dialog" @onclick:stopPropagation="true" role="dialog" aria-labelledby="hours-title" aria-modal="true">
        @{
            var report = S.WorkHoursReport;
            var today = DateOnly.FromDateTime(DateTime.Now);
            var tone = S.WorkHoursTone;
            var sheet = S.WorkTimesheet;
            var projects = S.WorkHoursProjects;
            var workedDays = report.Days.Count(d => d.HasWork);
        }
        <div class="hours-chrome">
            <div class="hours-head">
                <div>
                    <h2 id="hours-title">工時儀表板</h2>
                    <p class="hint">從開啟專案起算，依專案累計。同一人用 GitHub 帳號歸檔。</p>
                </div>
                <div class="hours-live" role="status" aria-atomic="true">
                    <span>歸檔 <strong>@S.WorkHoursPersonLabel</strong></span>
                    <span>本次 <strong>@S.SessionWorkText</strong></span>
                    <span>今日 <strong class="hours-tone-@tone">@S.TodayWorkText</strong></span>
                </div>
            </div>
            <div class="hours-toolbar">
                <div class="hours-tabs" role="tablist" aria-label="工時視圖" @onkeydown="OnViewKey">
                    <button type="button" role="tab" class="hours-tab @(S.WorkHoursView == WorkHoursView.Week ? "active" : null)"
                            aria-selected="@(S.WorkHoursView == WorkHoursView.Week)" @onclick="@(() => S.SetWorkHoursView(WorkHoursView.Week))">週</button>
                    <button type="button" role="tab" class="hours-tab @(S.WorkHoursView == WorkHoursView.Month ? "active" : null)"
                            aria-selected="@(S.WorkHoursView == WorkHoursView.Month)" @onclick="@(() => S.SetWorkHoursView(WorkHoursView.Month))">月</button>
                    <button type="button" role="tab" class="hours-tab @(S.WorkHoursView == WorkHoursView.Quarter ? "active" : null)"
                            aria-selected="@(S.WorkHoursView == WorkHoursView.Quarter)" @onclick="@(() => S.SetWorkHoursView(WorkHoursView.Quarter))">季</button>
                    <button type="button" role="tab" class="hours-tab @(S.WorkHoursView == WorkHoursView.Year ? "active" : null)"
                            aria-selected="@(S.WorkHoursView == WorkHoursView.Year)" @onclick="@(() => S.SetWorkHoursView(WorkHoursView.Year))">年</button>
                </div>
                <div class="hours-panes" role="tablist" aria-label="工時內容">
                    <button type="button" class="hours-pane @(S.WorkHoursPane == "dash" ? "active" : null)"
                            aria-selected="@(S.WorkHoursPane == "dash")" @onclick="@(() => S.SetWorkHoursPane("dash"))">儀表板</button>
                    <button type="button" class="hours-pane @(S.WorkHoursPane == "sheet" ? "active" : null)"
                            aria-selected="@(S.WorkHoursPane == "sheet")" @onclick="@(() => S.SetWorkHoursPane("sheet"))">報帳單</button>
                    <button type="button" class="hours-pane @(S.WorkHoursPane == "chart" ? "active" : null)"
                            aria-selected="@(S.WorkHoursPane == "chart")" @onclick="@(() => S.SetWorkHoursPane("chart"))">狀態圖</button>
                    <button type="button" class="hours-pane @(S.WorkHoursPane == "company" ? "active" : null)"
                            aria-selected="@(S.WorkHoursPane == "company")" @onclick="@(() => S.SetWorkHoursPane("company"))">公司</button>
                </div>
                <div class="hours-nav">
                    <button type="button" class="btn-sec" @onclick="@(() => S.ShiftWorkHours(-1))">@PrevLabel(S.WorkHoursView)</button>
                    <strong>@report.Title</strong>
                    <button type="button" class="btn-sec" disabled="@(!report.CanGoNext(today))" @onclick="@(() => S.ShiftWorkHours(1))">@NextLabel(S.WorkHoursView)</button>
                </div>
            </div>
            @if (tone != "ok" && report.RangeStart <= today && today <= report.RangeEnd)
            {
                <div class="hours-alert hours-alert-@tone" role="status">
                    @(tone == "over" ? "今日已超過 10 小時，請收工休息。" : "今日已滿 8 小時，注意別過勞。")
                </div>
            }
        </div>
        <div class="hours-body">
            @if (S.WorkHoursPane == "company")
            {
                var dest = S.SelectedReportingDestination;
                var me = S.CompanyMe;
                <div class="hours-company">
                    <p class="hint">這頁是選定公司給你的只讀資料（握手、派工、薪資條），不是戰情室或甘特。週／月切換只影響本機工時，不篩這家公司的派工。</p>
                    <div class="hours-list-head">
                        <h3 class="hours-panel-title">連線身分</h3>
                        <div class="btn-row">
                            <button type="button" class="btn-sec" disabled="@S.CompanyInfoBusy" @onclick="S.RefreshCompanySnapshotAsync">重新整理</button>
                            <button type="button" class="btn-sec" disabled="@(dest is null || string.IsNullOrWhiteSpace(dest.BaseUrl))" @onclick="S.OpenCompanyReportingInBrowser">在瀏覽器開公開回報</button>
                        </div>
                    </div>
                    @if (S.CompanyInfoBusy)
                    {
                        <p class="hint">正在向這家公司讀取身分與派工…</p>
                    }
                    else if (!string.IsNullOrEmpty(S.CompanyInfoHint) && me is null)
                    {
                        <p class="hint">@S.CompanyInfoHint</p>
                    }
                    else if (dest is null)
                    {
                        <p class="hint hours-list-empty">尚未連公司工作區。</p>
                        <button type="button" class="btn-sec" @onclick="@(() => S.OpenPreferences("company"))">開啟申報公司設定</button>
                    }
                    else
                    {
                        <div class="hours-stats">
                            <div class="hours-stat">
                                <span>目的地</span>
                                <strong>@(string.IsNullOrWhiteSpace(dest.DisplayName) ? dest.BaseUrl : dest.DisplayName)</strong>
                            </div>
                            <div class="hours-stat">
                                <span>名冊身分</span>
                                <strong>@(me is null ? "尚未讀取" : me.Matched ? (string.IsNullOrWhiteSpace(me.DisplayName) ? me.GitHubLogin : me.DisplayName) : "未對到人員")</strong>
                            </div>
                            <div class="hours-stat">
                                <span>GitHub</span>
                                <strong>@(string.IsNullOrWhiteSpace(me?.GitHubLogin) ? "—" : me.GitHubLogin)</strong>
                            </div>
                            <div class="hours-stat">
                                <span>角色</span>
                                <strong>@(string.IsNullOrWhiteSpace(me?.Role) ? "—" : me.Role)</strong>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(S.CompanyInfoHint))
                        {
                            <p class="hint">@S.CompanyInfoHint</p>
                        }
                        else if (me is { Matched: true } && !string.IsNullOrWhiteSpace(me.Message))
                        {
                            <p class="hint">@me.Message</p>
                        }
                    }

                    <section class="hours-sheet-project" aria-label="公司派工">
                        <div class="hours-list-head">
                            <h3 class="hours-panel-title">這家公司認為你在哪些專案</h3>
                            <span class="hint">@S.CompanyAssignments.Count 筆派工</span>
                        </div>
                        @if (S.CompanyAssignments.Count == 0)
                        {
                            <p class="hint hours-list-empty">這家公司目前沒有給你派工，或還沒讀到。沒有派工就無法把本機專案對過去。</p>
                        }
                        else
                        {
                            <table class="grid status-chart hours-company-table">
                                <thead>
                                    <tr>
                                        <th>專案</th>
                                        <th>角色</th>
                                        <th>每週時數</th>
                                        <th>期間</th>
                                        <th>倉</th>
                                        <th>本機對應</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var a in S.CompanyAssignments)
                                    {
                                        var local = S.LocalProjectNameFor(a);
                                        <tr>
                                            <td>@a.ProjectName</td>
                                            <td>@(string.IsNullOrWhiteSpace(a.Role) ? "—" : a.Role)</td>
                                            <td>@a.HoursPerWeek.ToString("0.##")</td>
                                            <td>@a.Start.ToString("yyyy-MM-dd") – @a.End.ToString("yyyy-MM-dd")</td>
                                            <td>@(a.Repos.Count == 0 ? "—" : string.Join("、", a.Repos))</td>
                                            <td>@(local is null ? "這段期間本機沒對上" : $"對得上「{local}」")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </section>

                    <section class="hours-sheet-project" aria-label="最近一次送到公司">
                        <h3 class="hours-panel-title">最近一次送到公司</h3>
                        @if (string.IsNullOrEmpty(S.CompanyUploadHint))
                        {
                            <p class="hint hours-list-empty">這個視窗還沒送出。按下方「送到〔這家公司〕」才上傳，不會背景偷傳。本機 work-hours.json 仍在。</p>
                        }
                        else
                        {
                            <p class="hint">@S.CompanyUploadHint</p>
                        }
                    </section>

                    <section class="hours-sheet-project" aria-label="薪資條">
                        <h3 class="hours-panel-title">最新薪資條</h3>
                        @if (S.CompanyPayslip is null)
                        {
                            <p class="hint hours-list-empty">這家公司還沒有你的薪資條，或對方不提供這個端點。費率與毛利不會出現在控制台。</p>
                        }
                        else
                        {
                            var slip = S.CompanyPayslip;
                            <div class="hours-stats">
                                <div class="hours-stat">
                                    <span>期間</span>
                                    <strong>@slip.PeriodStart.ToString("yyyy-MM-dd") – @slip.PeriodEnd.ToString("yyyy-MM-dd")</strong>
                                </div>
                                <div class="hours-stat">
                                    <span>狀態</span>
                                    <strong>@PayslipStatusLabel(slip.PeriodStatus)</strong>
                                </div>
                                <div class="hours-stat">
                                    <span>應發合計</span>
                                    <strong>@slip.PayableTotal.ToString("N0")</strong>
                                </div>
                                <div class="hours-stat">
                                    <span>列數</span>
                                    <strong>@slip.Lines.Count</strong>
                                </div>
                            </div>
                            @if (slip.Lines.Count > 0)
                            {
                                <table class="grid status-chart hours-company-table">
                                    <thead>
                                        <tr>
                                            <th>項目</th>
                                            <th>時數</th>
                                            <th>金額</th>
                                            <th>備註</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var line in slip.Lines)
                                        {
                                            <tr>
                                                <td>@PayslipKindLabel(line.Kind)</td>
                                                <td>@line.Hours.ToString("0.##")</td>
                                                <td>@line.Amount.ToString("N0")</td>
                                                <td>@(string.IsNullOrWhiteSpace(line.Note) ? "—" : line.Note)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        }
                    </section>
                </div>
            }
            else if (S.WorkHoursPane == "chart")
            {
                <div class="hours-chart-board">
                    <p class="hint">專案 × 日期，點一下加深投入。這不是公司甘特。派工與上傳結果改看「公司」分頁。按「送到公司」才上傳，不會背景偷傳。</p>
                    <table class="grid status-chart">
                        <thead>
                            <tr>
                                <th>專案</th>
                                @foreach (var day in S.StatusChartDays.Take(14))
                                {
                                    <th>@day.Month/@day.Day</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var project in projects)
                            {
                                <tr>
                                    <td>@project.Name</td>
                                    @foreach (var day in S.StatusChartDays.Take(14))
                                    {
                                        var n = S.ChartIntensity(project.Key, day);
                                        <td>
                                            <button type="button" class="chart-cell is-@n" @onclick="@(() => S.CycleStatusChart(project.Key, day))">@n</button>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (!string.IsNullOrEmpty(S.CompanyUploadHint))
                    {
                        <p class="hint">@S.CompanyUploadHint <button type="button" class="hours-link" @onclick="@(() => S.SetWorkHoursPane("company"))">看公司分頁</button></p>
                    }
                </div>
            }
            else if (S.WorkHoursPane != "sheet")
            {
                <div class="hours-dash">
                    <div class="hours-overview">
                        <div class="hours-stats">
                            <div class="hours-stat">
                                <span>總時數</span>
                                <strong>@WorkHoursFormat.Duration(report.Total)</strong>
                            </div>
                            <div class="hours-stat">
                                <span>工作天</span>
                                <strong>@report.WorkedDays 天</strong>
                            </div>
                            <div class="hours-stat">
                                <span>工作日均</span>
                                <strong>@WorkHoursFormat.Duration(report.AverageWorkedDay)</strong>
                            </div>
                            <div class="hours-stat">
                                <span>最長一天</span>
                                <strong>@WorkHoursFormat.Duration(report.LongestDay)</strong>
                            </div>
                        </div>

                        <div class="hours-projects" aria-label="各專案時數">
                            <div class="hours-list-head">
                                <h3 class="hours-panel-title">各專案時數</h3>
                                @if (!string.IsNullOrEmpty(S.WorkHoursProjectFilter))
                                {
                                    <button type="button" class="hours-link" @onclick="@(() => S.SetWorkHoursProjectFilter(null))">顯示全部</button>
                                }
                            </div>
                            @if (projects.Count == 0)
                            {
                                <p class="hint hours-list-empty">這個期間還沒有工時。開啟專案後才會開始計時。</p>
                            }
                            else
                            {
                                <div class="hours-project-list">
                                    @foreach (var project in projects)
                                    {
                                        <button type="button"
                                                class="hours-project @(string.Equals(S.WorkHoursProjectFilter, project.Key, StringComparison.OrdinalIgnoreCase) ? "is-on" : null) @(project.IsUnallocated ? "is-open" : null)"
                                                @onclick="@(() => S.SetWorkHoursProjectFilter(string.Equals(S.WorkHoursProjectFilter, project.Key, StringComparison.OrdinalIgnoreCase) ? null : project.Key))">
                                            <span>
                                                <strong>@project.Name</strong>
                                                @if (!string.IsNullOrWhiteSpace(project.GithubSlug))
                                                {
                                                    <em>@project.GithubSlug</em>
                                                }
                                            </span>
                                            <span class="hours-project-meta">
                                                <strong>@WorkHoursFormat.Duration(project.Duration)</strong>
                                                <em>@project.WorkedDays 天</em>
                                            </span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>

                        <div class="hours-viz">
                            <section class="hours-chart" aria-label="@report.Title 工時圖">
                                <h3 class="hours-panel-title">@(S.WorkHoursView is WorkHoursView.Week or WorkHoursView.Month ? "每日工時" : "每月工時")</h3>
                                <div class="hours-chart-plot">
                                    @if (S.WorkHoursView is WorkHoursView.Week or WorkHoursView.Month && report.ChartMax >= TimeSpan.FromHours(WorkHoursFormat.SoftHours))
                                    {
                                        <div class="hours-chart-line" style="bottom: @SoftLineBottom(report)" aria-hidden="true" title="8 小時"></div>
                                    }
                                    @foreach (var bar in report.Chart)
                                    {
                                        var height = BarHeight(bar.Duration, report.ChartMax);
                                        var barTone = DailyTone(S.WorkHoursView, bar.Duration);
                                        <button type="button" class="hours-bar-col @(bar.IsCurrent ? "is-today" : null)"
                                                title="@BarTitle(S.WorkHoursView, bar)"
                                                @onclick="@(() => S.OpenWorkHoursBucket(bar.Start))">
                                            <span class="hours-bar-val">@(bar.Duration > TimeSpan.Zero ? WorkHoursFormat.Hours(bar.Duration) : "")</span>
                                            <span class="hours-bar-track">
                                                <span class="hours-bar hours-bar-@barTone" style="height: @height%"></span>
                                            </span>
                                        </button>
                                    }
                                </div>
                                <div class="hours-chart-labels">
                                    @foreach (var bar in report.Chart)
                                    {
                                        <span class="hours-bar-label @(bar.IsCurrent ? "is-today" : null)">@bar.Label</span>
                                    }
                                </div>
                            </section>
                            <section class="hours-clock" aria-label="生理時鐘">
                                <h3 class="hours-panel-title">生理時鐘</h3>
                                <p class="hours-clock-summary">@report.Clock.Summary</p>
                                <div class="hours-bands">
                                    @foreach (var band in report.Clock.Bands)
                                    {
                                        <div class="hours-band @(band.Band == report.Clock.Dominant ? "is-top" : null)">
                                            <span>@band.Label</span>
                                            <strong>@band.Percent%</strong>
                                            <em>@band.Window</em>
                                        </div>
                                    }
                                </div>
                                <div class="hours-hourly" role="img" aria-label="24 小時工時分布">
                                    @for (var hour = 0; hour < 24; hour++)
                                    {
                                        var dur = hour < report.Clock.Hourly.Count ? report.Clock.Hourly[hour] : TimeSpan.Zero;
                                        var height = BarHeight(dur, report.Clock.HourlyMax);
                                        <span class="hours-hourly-col" title="@($"{hour:00} 時 · {WorkHoursFormat.Duration(dur)}")">
                                            <span class="hours-hourly-bar" style="height: @(dur > TimeSpan.Zero ? height : 2)%"></span>
                                        </span>
                                    }
                                </div>
                                <div class="hours-hourly-axis" aria-hidden="true">
                                    <span>0</span><span>6</span><span>12</span><span>18</span><span>24</span>
                                </div>
                            </section>
                        </div>
                    </div>

                    <section class="hours-list-wrap" aria-label="每日時段">
                        <div class="hours-list-head">
                            <h3 class="hours-list-title">每日時段</h3>
                            <span class="hint">@(workedDays == 0 ? "這個期間尚無紀錄" : $"{workedDays} 天有紀錄，清單可捲動")</span>
                        </div>
                        @if (report.Days.All(d => !d.HasWork))
                        {
                            <p class="hint hours-list-empty">開啟專案的時間會自動累計到這裡。</p>
                        }
                        else
                        {
                            <ul class="hours-days">
                                @foreach (var day in report.Days)
                                {
                                    <li class="hours-day @(day.Date == today ? "is-today" : null) @(!day.HasWork ? "is-empty" : null)">
                                        <div class="hours-day-head">
                                            <strong>@WorkHoursFormat.DayTitle(day.Date)</strong>
                                            <span class="hours-tone-@WorkHoursFormat.Tone(day.Duration)">@(day.HasWork ? WorkHoursFormat.Duration(day.Duration) : "休息")</span>
                                        </div>
                                        @if (day.HasWork)
                                        {
                                            <div class="hours-day-track" role="img" aria-label="@DayTrackLabel(day)">
                                                @for (var hour = 0; hour < 24; hour++)
                                                {
                                                    var dur = hour < day.Hourly.Count ? day.Hourly[hour] : TimeSpan.Zero;
                                                    <span class="hours-tick hours-tick-@HourLevel(dur)" title="@($"{hour:00} 時 · {WorkHoursFormat.Duration(dur)}")"></span>
                                                }
                                            </div>
                                            <div class="hours-periods">
                                                @foreach (var period in day.Periods)
                                                {
                                                    <span>@period.ClockLabel</span>
                                                }
                                            </div>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </section>
                </div>
            }
            else
            {
                <div class="hours-sheet">
                    <div class="hours-stats">
                        <div class="hours-stat">
                            <span>可報帳總時數</span>
                            <strong>@WorkHoursFormat.Duration(sheet?.BillableTotal ?? TimeSpan.Zero)</strong>
                        </div>
                        <div class="hours-stat">
                            <span>專案數</span>
                            <strong>@(sheet?.Projects.Count ?? 0)</strong>
                        </div>
                        <div class="hours-stat">
                            <span>Issue</span>
                            <strong>@(sheet?.Items.Count(i => i.Kind != "pr") ?? 0)</strong>
                        </div>
                        <div class="hours-stat">
                            <span>PR</span>
                            <strong>@(sheet?.Items.Count(i => i.Kind == "pr") ?? 0)</strong>
                        </div>
                    </div>
                    @if (sheet is not null && sheet.UnallocatedTotal > TimeSpan.Zero)
                    {
                        <p class="hint">另有 @WorkHoursFormat.Duration(sheet.UnallocatedTotal) 是控制台舊制、未掛專案的時段，不列入這張單。</p>
                    }
                    @if (S.WorkHoursTimesheetBusy)
                    {
                        <p class="hint">正在讀取 GitHub 的 Issue／PR…</p>
                    }
                    else if (!string.IsNullOrEmpty(S.WorkHoursTimesheetHint))
                    {
                        <p class="hint">@S.WorkHoursTimesheetHint</p>
                    }
                    @if (sheet is null || sheet.Projects.Count == 0)
                    {
                        <p class="hint hours-list-empty">這個期間沒有可報帳的專案工時。</p>
                    }
                    else
                    {
                        @foreach (var project in sheet.Projects)
                        {
                            <section class="hours-sheet-project">
                                <div class="hours-day-head">
                                    <strong>@project.Name</strong>
                                    <span>@WorkHoursFormat.Duration(project.Duration)</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(project.GithubSlug))
                                {
                                    <p class="hint">@project.GithubSlug</p>
                                }
                                @if (project.Days.Count > 0)
                                {
                                    <div class="hours-periods">
                                        @foreach (var day in project.Days)
                                        {
                                            <span>@WorkHoursFormat.DayTitle(day.Date) @WorkHoursFormat.Duration(day.Duration)</span>
                                        }
                                    </div>
                                }
                                @if (project.Issues.Count > 0)
                                {
                                    <h4 class="hours-panel-title">已關閉 Issue</h4>
                                    <ul class="hours-items">
                                        @foreach (var item in project.Issues)
                                        {
                                            <li>
                                                @if (!string.IsNullOrWhiteSpace(item.Url))
                                                {
                                                    <a href="@item.Url" target="_blank" rel="noreferrer">@item.NumberText @item.Title</a>
                                                }
                                                else
                                                {
                                                    <span>@item.NumberText @item.Title</span>
                                                }
                                                <em>@item.AtText</em>
                                            </li>
                                        }
                                    </ul>
                                }
                                @if (project.PullRequests.Count > 0)
                                {
                                    <h4 class="hours-panel-title">開啟／合併的 PR</h4>
                                    <ul class="hours-items">
                                        @foreach (var item in project.PullRequests)
                                        {
                                            <li>
                                                @if (!string.IsNullOrWhiteSpace(item.Url))
                                                {
                                                    <a href="@item.Url" target="_blank" rel="noreferrer">@item.NumberText @item.Title</a>
                                                }
                                                else
                                                {
                                                    <span>@item.NumberText @item.Title</span>
                                                }
                                                <em>@item.State · @item.AtText</em>
                                            </li>
                                        }
                                    </ul>
                                }
                                @if (project.Issues.Count == 0 && project.PullRequests.Count == 0)
                                {
                                    <p class="hint">@(string.IsNullOrWhiteSpace(project.ContributionNote) ? "這個期間沒有可列出的 Issue／PR。" : project.ContributionNote)</p>
                                }
                            </section>
                        }
                    }
                </div>
            }
        </div>
        <div class="dialog-actions hours-actions">
            <span class="hint grow">@(S.WorkHoursPane == "company" ? "派工與薪資條來自選定公司，只讀；本機 work-hours.json 仍是工時真相。" : "可報帳時數寫在本機 work-hours.json；匯出 Markdown 與 CSV 給負責人汇整。")</span>
            <button class="btn-sec" disabled="@(S.WorkHoursExporting || sheet is null)" @onclick="S.ExportWorkTimesheetAsync">匯出工時單</button>
            @if (S.EnabledReportingDestinations.Count > 0)
            {
                <select class="hours-dest" value="@S.SelectedReportingDestinationId" @onchange="OnDest">
                    @foreach (var d in S.EnabledReportingDestinations)
                    {
                        <option value="@d.Id">@d.DisplayName</option>
                    }
                </select>
            }
            <button class="btn-primary" disabled="@(S.CompanyUploadBusy || S.EnabledReportingDestinations.Count == 0)" title="@(S.EnabledReportingDestinations.Count == 0 ? "請先在設定「申報公司」加入、測試連線並啟用" : "")" @onclick="S.SendTimesheetToCompanyAsync">@S.SendToCompanyLabel</button>
            <button class="btn-primary" @onclick="S.CloseDialog">關閉</button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public ConsoleSession S { get; set; } = default!;

    void OnDest(ChangeEventArgs e) => S.SetSelectedReportingDestination(e.Value?.ToString() ?? "");

    static string PayslipStatusLabel(string status) => status switch
    {
        "Locked" => "已鎖定",
        "PmConfirming" => "核算中",
        "Collecting" => "收集中",
        _ => string.IsNullOrWhiteSpace(status) ? "—" : status,
    };

    static string PayslipKindLabel(string kind) => kind switch
    {
        "Monthly" => "月薪",
        "Hourly" => "時計",
        "OvertimePending" => "加班待核",
        "ProjectBonus" => "專案獎金",
        _ => string.IsNullOrWhiteSpace(kind) ? "—" : kind,
    };

    static string PrevLabel(WorkHoursView view) => view switch
    {
        WorkHoursView.Week => "上一週",
        WorkHoursView.Month => "上一月",
        WorkHoursView.Quarter => "上一季",
        _ => "上一年",
    };

    static string NextLabel(WorkHoursView view) => view switch
    {
        WorkHoursView.Week => "下一週",
        WorkHoursView.Month => "下一月",
        WorkHoursView.Quarter => "下一季",
        _ => "下一年",
    };

    static string DailyTone(WorkHoursView view, TimeSpan duration) =>
        view is WorkHoursView.Week or WorkHoursView.Month ? WorkHoursFormat.Tone(duration) : "ok";

    static string BarTitle(WorkHoursView view, WorkHoursBucket bar) =>
        view is WorkHoursView.Week or WorkHoursView.Month
            ? $"{WorkHoursFormat.DayTitle(bar.Start)} · {WorkHoursFormat.Duration(bar.Duration)}"
            : $"{bar.Start.Year}年{bar.Label} · {WorkHoursFormat.Duration(bar.Duration)}";

    static int BarHeight(TimeSpan duration, TimeSpan max)
    {
        if (max <= TimeSpan.Zero || duration <= TimeSpan.Zero)
            return 2;
        var pct = (int)Math.Round(100 * duration.TotalMinutes / max.TotalMinutes);
        return Math.Clamp(pct, 4, 100);
    }

    static string SoftLineBottom(WorkHoursReport report)
    {
        if (report.ChartMax <= TimeSpan.Zero)
            return "0%";
        var pct = 100 * WorkHoursFormat.SoftHours / report.ChartMax.TotalHours;
        return Math.Clamp(pct, 0, 100).ToString("0.##") + "%";
    }

    static int HourLevel(TimeSpan value)
    {
        var minutes = value.TotalMinutes;
        if (minutes <= 0)
            return 0;
        if (minutes >= 45)
            return 4;
        if (minutes >= 25)
            return 3;
        if (minutes >= 10)
            return 2;
        return 1;
    }

    static string DayTrackLabel(WorkDaySlice day) =>
        day.HasWork
            ? $"{WorkHoursFormat.DayTitle(day.Date)} 工作時段 {string.Join("、", day.Periods.Select(p => p.ClockLabel))}"
            : $"{WorkHoursFormat.DayTitle(day.Date)} 休息";

    void OnViewKey(KeyboardEventArgs e)
    {
        var tabs = new[] { WorkHoursView.Week, WorkHoursView.Month, WorkHoursView.Quarter, WorkHoursView.Year };
        var i = Array.IndexOf(tabs, S.WorkHoursView);
        if (i < 0)
            return;
        var next = e.Key switch
        {
            "ArrowRight" or "ArrowDown" => tabs[(i + 1) % tabs.Length],
            "ArrowLeft" or "ArrowUp" => tabs[(i - 1 + tabs.Length) % tabs.Length],
            "Home" => tabs[0],
            "End" => tabs[^1],
            _ => (WorkHoursView?)null
        };
        if (next is { } view)
            S.SetWorkHoursView(view);
    }
}
