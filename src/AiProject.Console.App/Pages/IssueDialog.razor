@if (S.Dialog == "issue" && S.ActiveIssue is { } issue)
{
    <AppDialog Title="@($"{issue.NumberText} {issue.Title}")"
               Hint="@IssueCompletion.DialogHint"
               TitleId="issue-dialog-title"
               OnClose="S.CloseDialog">
        <ChildContent>
            <div class="issue-meta">
                @if (!string.IsNullOrEmpty(issue.LabelText))
                {
                    <span>@issue.LabelText</span>
                }
                @if (!string.IsNullOrEmpty(issue.WhenText()))
                {
                    <span>@issue.WhenText()</span>
                }
                @if (!string.IsNullOrEmpty(issue.TraceChipText))
                {
                    <span class="duty-chip is-@issue.TraceChipTone">@issue.TraceChipText</span>
                }
                <span>目前分支 @S.IssueBranchText</span>
            </div>
            <section class="issue-steps" aria-label="完成步驟">
                <ol>
                    <li><strong>送出回應</strong>：把進度寫進這則 Issue 的討論。只是留言，不會關閉任務。</li>
                    <li><strong>建立 PR</strong>：用功能分支上的提交開 Pull Request。合併後才會關閉這則 Issue。</li>
                </ol>
                @if (!string.IsNullOrEmpty(S.IssuePrBlockReason))
                {
                    <p class="issue-pr-block">@S.IssuePrBlockReason</p>
                }
                else if (S.PullRequest is { HasPr: true })
                {
                    <p class="hint">目前分支已有 PR。可開啟查看檢查；審查與合併仍到 GitHub。</p>
                }
                else
                {
                    <p class="hint">建立時會在說明寫入 Closes @issue.NumberText，合併即關閉此任務。</p>
                }
            </section>
            <div class="issue-body doc-preview">@((MarkupString)S.IssueBodyHtml)</div>
            @if (!string.IsNullOrEmpty(S.IssueViewHint))
            {
                <p class="hint">@S.IssueViewHint</p>
            }
            @if (S.IssueComments.Count > 0)
            {
                <section class="issue-comments" aria-label="討論">
                    @foreach (var comment in S.IssueComments)
                    {
                        <article class="issue-comment">
                            <div class="issue-comment-head">
                                <span class="issue-comment-author">@comment.AuthorText</span>
                                @if (!string.IsNullOrEmpty(comment.WhenText()))
                                {
                                    <span class="issue-comment-when">@comment.WhenText()</span>
                                }
                            </div>
                            <div class="issue-comment-body">@((MarkupString)DocsMarkdown.ToSafeHtml(comment.Body))</div>
                        </article>
                    }
                </section>
            }
            <div class="issue-reply">
                <div class="field" style="align-items:start">
                    <span>回應</span>
                    <textarea @bind="S.IssueCommentDraft"
                              @bind:event="oninput"
                              disabled="@(S.JobBusy || S.IssueViewBusy)"
                              placeholder="寫給這則 Issue 的留言（回報進度，不會關閉任務）…"></textarea>
                </div>
            </div>
        </ChildContent>
        <Actions>
            <button type="button" class="btn-sec" @onclick="S.CloseDialog">關閉</button>
            <button type="button" class="btn-sec" disabled="@(string.IsNullOrEmpty(issue.Url))" @onclick="S.OpenActiveIssueUrl">在 GitHub 開啟</button>
            <span class="grow"></span>
            <button type="button" class="btn-sec" disabled="@S.JobBusy" @onclick="S.OpenActiveIssueHelpAsync">請 Agent 協助</button>
            <button type="button" class="btn-sec" disabled="@(!S.CanSubmitIssueComment)" @onclick="S.SubmitIssueCommentAsync">送出回應</button>
            @if (S.IssueNeedsTaskBranch)
            {
                <button type="button" class="btn-sec" disabled="@S.JobBusy" @onclick="S.OpenIssueTaskBranchAsync">為此任務建立分支</button>
            }
            <button type="button"
                    class="btn-primary"
                    disabled="@(!S.CanUseIssuePr)"
                    title="@(S.PullRequest is { HasPr: true } ? "開啟目前分支的 PR" : "用目前分支開 PR；合併後關閉此 Issue")"
                    @onclick="S.OpenIssuePrAsync">@S.IssuePrButtonLabel</button>
        </Actions>
    </AppDialog>
}

@code {
    [Parameter, EditorRequired]
    public ConsoleSession S { get; set; } = default!;
}
