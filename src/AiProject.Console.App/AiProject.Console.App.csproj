<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AiProject.Console.App</RootNamespace>
    <AssemblyName>AI_Project_Console</AssemblyName>
    <ApplicationTitle>AI_Project 控制台</ApplicationTitle>
    <Version>0.4.3</Version>
    <InformationalVersion>0.4.3</InformationalVersion>
    <Product>AI_Project 控制台</Product>
    <Authors>sjvann</Authors>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.41.3" />
    <PackageReference Include="Photino.Blazor" Version="4.0.13" />
    <ProjectReference Include="..\AiProject.Console.Core\AiProject.Console.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
