<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AiProject.Console.App</RootNamespace>
    <AssemblyName>AI_Project_Console</AssemblyName>
    <ApplicationTitle>AI_Project 控制台</ApplicationTitle>
    <Version>0.6.19</Version>
    <InformationalVersion>0.6.19</InformationalVersion>
    <Product>AI_Project 控制台</Product>
    <Authors>sjvann</Authors>
    <Copyright>Copyright (c) 2026 sjvann. All rights reserved.</Copyright>
    <Description>本機控制台</Description>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64;osx-arm64;osx-x64;linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- Windows 會擋未簽名的 Debug apphost（dotnet run → 存取被拒）。改由已簽名的 dotnet.exe 載入 DLL。 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <Import Project="UnlockLockedOutputs.targets" />

  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.41.3" />
    <PackageReference Include="Photino.Blazor" Version="4.0.13" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <ProjectReference Include="..\AiProject.Console.Core\AiProject.Console.Core.csproj" />
    <ProjectReference Include="..\AiProject.Console.CompanyClient\AiProject.Console.CompanyClient.csproj" />
    <ProjectReference Include="..\AiProject.Shared.Hosting\AiProject.Shared.Hosting.csproj" />
  </ItemGroup>

  <!-- Photino 不走 RCL _content；直接複製 tokens 避免 StaticWebAssets 重複鍵 -->
  <ItemGroup>
    <Content Include="..\AiProject.Shared.DesignSystem\wwwroot\tokens\tokens.css" Link="wwwroot\css\tokens.css">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
