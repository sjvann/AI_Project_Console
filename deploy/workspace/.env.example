# 複製為 .env 後再 docker compose up（勿提交真實密碼）
HOSTING_MODE=SelfHosted
WORKSPACE_PORT=5100
WORKSPACE_IMAGE=aiproject-workspace:local
POSTGRES_PASSWORD=aiproject-change-me
# 32 bytes Base64 — 產生： [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }) -as [byte[]])
COMPANY_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
OWNER_ENABLED=true
OWNER_USER=owner
OWNER_PASSWORD=AiProject-Owner-ChangeMe
OWNER_DISPLAY=公司管理員
SEED_DEMO=false
GITHUB_ORG=
GITHUB_TOKEN=
