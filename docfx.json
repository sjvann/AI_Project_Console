{
  "metadata": [
    {
      "src": [
        {
          "src": ".",
          "files": [
            "src/AiProject.Console.Core/AiProject.Console.Core.csproj",
            "src/AiProject.Console.Mcp/AiProject.Console.Mcp.csproj"
          ]
        }
      ],
      "dest": "api",
      "includePrivateMembers": false,
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "toc.yml"
        ]
      },
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "src": "docs",
        "dest": "docs"
      },
      {
        "files": [
          "**/*.yml",
          "index.md"
        ],
        "src": "api",
        "dest": "api"
      },
      {
        "files": [ "README.md" ],
        "src": "scripts",
        "dest": "scripts"
      }
    ],
    "resource": [
      {
        "files": [ "logo.svg" ],
        "src": "assets/brand",
        "dest": "images"
      },
      {
        "files": [ "favicon.ico" ],
        "src": "src/AiProject.Console.App/wwwroot",
        "dest": "images"
      },
      {
        "files": [ "**" ],
        "src": "schema",
        "dest": "schema"
      }
    ],
    "output": "_site",
    "template": [ "default", "modern", "templates" ],
    "globalMetadata": {
      "_appName": "AI_Project 控制台",
      "_appTitle": "AI_Project 控制台",
      "_appFooter": "<span>AI_Project 控制台 · <a href=\"https://sjvann.github.io/AI_Project_Console/\">使用文件</a></span>",
      "_appLogoPath": "images/logo.svg",
      "_appFaviconPath": "images/favicon.ico",
      "_enableSearch": true,
      "_lang": "zh-Hant",
      "_gitContribute": {
        "repo": "https://github.com/sjvann/AI_Project_Console.git",
        "branch": "main"
      }
    },
    "sitemap": {
      "baseUrl": "https://sjvann.github.io/AI_Project_Console/"
    }
  }
}
